/**
 * Decrypts sensitive user fields returned by native SQL queries.
 *
 * IMPORTANT:
 * JPA AttributeConverter works automatically when a User entity
 * is loaded.
 *
 * However, native queries returning Map<String, Object> bypass
 * the entity converter.
 *
 * Therefore EMAIL and PHONE_NUMBER must be decrypted explicitly
 * before returning the data to the caller.
 */
private void decryptUserSensitiveFields(Map<String, Object> user) {

    if (user == null || user.isEmpty()) {
        return;
    }

    // Decrypt EMAIL if present.
    Object encryptedEmail = user.get("email");

    if (encryptedEmail != null) {
        user.put(
                "email",
                databaseEncryptionUtil.decrypt(
                        encryptedEmail.toString()
                )
        );
    }

    // Decrypt PHONE_NUMBER if present.
    Object encryptedPhone = user.get("phone_number");

    if (encryptedPhone != null) {
        user.put(
                "phone_number",
                databaseEncryptionUtil.decrypt(
                        encryptedPhone.toString()
                )
        );
    }
}
