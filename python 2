import React, { useEffect, useMemo, useState } from "react";
import {
  Box,
  Typography,
  List,
  ListItemButton,
  ListItemText,
  Stack,
  Divider,
  Chip,
  IconButton,
  Paper,
  Fade,
  useTheme,
} from "@mui/material";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import MenuBookIcon from "@mui/icons-material/MenuBook";
import { useSelector } from "react-redux";
import { GUIDE_DATA } from "../data/guideData";
import CustomChip from "../../../utils/CustomChip";

export default function UserGuides({ setUserGuideOpen }) {
  const theme = useTheme();
  const [selectedModule, setSelectedModule] = useState(null);
  const permittedMenus = useSelector((s) => s.menus.menus);

  // 1. Flatten IDs
  const allAvailableIds = useMemo(() => {
    const ids = new Set();
    permittedMenus.forEach((menu) => {
      ids.add(menu.id);
      if (menu.children) menu.children.forEach((child) => ids.add(child.id));
    });
    return Array.from(ids);
  }, [permittedMenus]);

  // 2. Filter Guides
  const modules = useMemo(() => {
    return GUIDE_DATA.filter((guide) =>
      allAvailableIds.includes(Number(guide.permissionId)),
    );
  }, [allAvailableIds]);

  // 3. Set Default Selection
  useEffect(() => {
    if (modules.length > 0 && !selectedModule) {
      setSelectedModule(modules[0]);
    }
  }, [modules, selectedModule]);

  return (
    <Box
      sx={{
        display: "flex",
        flexDirection: { xs: "column", md: "row" },
        gap: 3,
        p: { xs: 1, md: 3 },
        height: "75vh",
      }}
    >
      {/* 🔹 LEFT PANEL: Module Navigation */}
      <Paper
        elevation={0}
        sx={{
          width: { xs: "100%", md: 300 },
          border: `1px solid ${theme.palette.divider}`,
          display: "flex",
          flexDirection: "column",
          // overflow: "hidden",
        }}
      >
        <Box p={2}>
          <Stack direction="row" alignItems="center" spacing={1}>
            <IconButton onClick={setUserGuideOpen} size="small">
              <ArrowBackIcon fontSize="small" />
            </IconButton>
            <Typography variant="subtitle1" fontWeight={700}>
              System Guides
            </Typography>
          </Stack>
        </Box>
        <Divider />
        <List sx={{ overflowY: "auto", p: 1 }}>
          {modules.map((item) => (
            <ListItemButton
              key={item.permissionId}
              selected={selectedModule?.permissionId === item.permissionId}
              onClick={() => setSelectedModule(item)}
              sx={{
                borderRadius: 2,
                mb: 0.5,
                "&.Mui-selected": {
                  bgcolor: `${theme.palette.primary.main}10`,
                  color: "primary.main",
                  "&:hover": { bgcolor: `${theme.palette.primary.main}20` },
                },
              }}
            >
              <ListItemText
                primary={item.module}
                primaryTypographyProps={{ variant: "body2", fontWeight: 600 }}
              />
            </ListItemButton>
          ))}
        </List>
      </Paper>

      {/* 🔹 RIGHT PANEL: Content Display */}
      <Paper
        elevation={0}
        sx={{
          flex: 1,
          border: `1px solid ${theme.palette.divider}`,
          display: "flex",
          flexDirection: "column",
          overflow: "hidden",
          bgcolor: "background.default",
        }}
      >
        {selectedModule ? (
          <Fade in={true} timeout={400}>
            <Box
              sx={{ display: "flex", flexDirection: "column", height: "100%" }}
            >
              {/* Header */}
              <Box
                p={3}
                bgcolor="background.paper"
                borderBottom={`1px solid ${theme.palette.divider}`}
              >
                <Stack
                  direction="row"
                  justifyContent="space-between"
                  alignItems="center"
                >
                  <Typography
                    variant="h5"
                    fontWeight={800}
                    color="primary.main"
                  >
                    {selectedModule.module}
                  </Typography>
                  <CustomChip
                    label={`${selectedModule.steps.length} Steps`}
                    size="small"
                    variant="outlined"
                    icon={<MenuBookIcon sx={{ fontSize: "14px !important" }} />}
                  />
                </Stack>
              </Box>

              {/* Steps List */}
              <Box
                sx={{
                  p: 3,
                  overflowY: "auto",
                  bgcolor: theme.palette.action.hover + "40",
                }}
              >
                <Stack spacing={2}>
                  {selectedModule.steps.map((step, index) => (
                    <Paper
                      key={index}
                      elevation={0}
                      sx={{
                        p: 2.5,
                        borderRadius: 3,
                        border: `1px solid ${theme.palette.divider}`,
                        transition: "0.2s",
                        "&:hover": {
                          boxShadow: theme.shadows[2],
                          borderColor: "primary.light",
                        },
                      }}
                    >
                      <Stack
                        direction="row"
                        spacing={2}
                        alignItems="flex-start"
                      >
                        <Box
                          sx={{
                            width: 32,
                            height: 32,
                            borderRadius: "50%",
                            bgcolor: "primary.main",
                            color: "white",
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            flexShrink: 0,
                            fontSize: "0.75rem",
                            fontWeight: "bold",
                            mt: 0.2,
                          }}
                        >
                          {index + 1}
                        </Box>
                        <Typography
                          variant="body1"
                          sx={{
                            color: "text.primary",
                            pt: 0.4,
                            lineHeight: 1.6,
                          }}
                        >
                          {step}
                        </Typography>
                      </Stack>
                    </Paper>
