package com.tcs.userservice.dto;

import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.Size;
import lombok.Data;

@Data
@JsonIgnoreProperties(ignoreUnknown = true)
public class UserPayloadDto {

    @NotBlank(message = "User ID is required.")
    @Pattern(regexp = "^(v|tcs)?\\d{7}$", message = "Invalid User Id format.")
    private String userId;

    @NotBlank(message = "First Name is mandatory")
    @Size(min = 3, max = 30)
    @Pattern(regexp = "^[a-zA-Z. ]+$", message = "First Name: letters, spaces, and dots only.")
    private String firstName;

    @Size(max = 30)
    @Pattern(regexp = "^[a-zA-Z. ]*$", message = "Middle Name: letters, spaces, and dots only.")
    private String middleName;

    @Size(max = 30)
    @Pattern(regexp = "^[a-zA-Z. ]*$", message = "Last Name: letters, spaces, and dots only.")
    private String lastName;

    @NotBlank(message = "Email is mandatory")
    @Pattern(regexp = "^[a-zA-Z0-9._%+-]+@sbi\\.co\\.in$", message = "Email must be a valid @sbi.co.in address")
    private String email;

    @Pattern(regexp = "^$|[1-9][0-9]{9}$", message = "Mobile Number: 10 digits only, cannot start with 0.")
    private String phoneNumber;

    @NotNull(message = "Role is mandatory")
    private Integer roleId;

    private String roleName;

    private Integer branch;

    private String branchName;

    @Pattern(regexp = "^(ACTIVE|INACTIVE|LOCKED|BLOCKED|CANCELLED|REJECTED|ACCEPTED)$")
    private String accountStatus;


}
