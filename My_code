import { useEffect, useState, useRef } from "react";
import {
  Box,
  Typography,
  Stack,
  Paper,
  Chip,
  Button,
} from "@mui/material";

export default function AiAssistant() {
  const [messages, setMessages] = useState([]);
  const [modules, setModules] = useState([]);
  const [questions, setQuestions] = useState([]);
  const [selectedModule, setSelectedModule] = useState(null);
  const [showCount, setShowCount] = useState(3);
  const [showFollowUp, setShowFollowUp] = useState(false);
  const [typingDots, setTypingDots] = useState(false);

  const messagesEndRef = useRef(null);

  /* 🔹 Auto scroll */
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, typingDots]);

  /* 🔹 Init */
  useEffect(() => {
    setModules([
      { code: "CIRCLE", name: "Circle Management" },
      { code: "CGL", name: "CGL Management" },
      { code: "BRANCH", name: "Branch Management" },
    ]);

    setMessages([
      {
        from: "bot",
        text: "👋 Hi, I’m your Fincore Assistant. Please select a module to continue.",
      },
    ]);
  }, []);

  /* 🔹 Helpers */
  const addUserMessage = (text) =>
    setMessages((prev) => [...prev, { from: "user", text }]);

  const addBotMessage = (text) =>
    setMessages((prev) => [...prev, { from: "bot", text }]);

  const startTyping = () => setTypingDots(true);
  const stopTyping = () => setTypingDots(false);

  /* 🔹 Module select */
  const handleModuleSelect = (module) => {
    setSelectedModule(module);
    setShowCount(3);
    setShowFollowUp(false);

    addUserMessage(module.name);
    startTyping();

    setTimeout(() => {
      const moduleQuestions = {
        CIRCLE: [
          "How do I create a circle?",
          "Who can approve a circle request?",
          "Where can I view circle details?",
          "Can I edit an approved circle?",
          "How to track circle request status?",
        ],
        CGL: [
          "How do I create a CGL?",
          "What is the approval flow for CGL?",
          "Where can I view CGL details?",
        ],
        BRANCH: [
          "How do I create a branch?",
          "Who approves branch requests?",
          "Where can I view branch details?",
        ],
      };

      setQuestions(moduleQuestions[module.code] || []);
      addBotMessage(`Here are some common questions for ${module.name}.`);
      stopTyping();
    }, 1000);
  };

  /* 🔹 Question select */
  const handleQuestionSelect = (question) => {
    addUserMessage(question);
    startTyping();

    setTimeout(() => {
      addBotMessage(
        "Please navigate to the respective module, click Create, fill mandatory details, and submit for approval."
      );
      addBotMessage("Would you like to ask another question?");
      setShowFollowUp(true);
      stopTyping();
    }, 1200);
  };

  /* 🔹 Follow-up */
  const handleFollowUp = (answer) => {
    addUserMessage(answer);
    setShowFollowUp(false);

    if (answer === "Yes") {
      addBotMessage("Sure 🙂 Please select another question.");
    } else {
      addBotMessage(
        "Thank you for using Fincore Assistant. Feel free to reach out anytime. Have a great day! 👋"
      );
      setQuestions([]);
    }
  };

  return (
    <Box sx={{ height: "100%", display: "flex", flexDirection: "column", bgcolor: "#f5f7fb" }}>
      {/* CHAT */}
      <Box sx={{ flex: 1, overflowY: "auto", p: 2 }}>
        <Stack spacing={2}>
          {messages.map((msg, index) => (
            <Stack
              key={index}
              direction="row"
              justifyContent={msg.from === "user" ? "flex-end" : "flex-start"}
            >
              <Paper
                sx={{
                  p: 1.5,
                  maxWidth: "75%",
                  bgcolor: msg.from === "user" ? "primary.main" : "grey.200",
                  color: msg.from === "user" ? "#fff" : "#000",
                }}
              >
                <Typography variant="body2">{msg.text}</Typography>
              </Paper>
            </Stack>
          ))}

          {/* ✅ WhatsApp-style typing dots */}
          {typingDots && (
            <Stack direction="row">
              <Paper sx={{ p: 1.2, bgcolor: "grey.200" }}>
                <Box sx={{ display: "flex", gap: 0.5 }}>
                  <span className="dot" />
                  <span className="dot" />
                  <span className="dot" />
                </Box>
              </Paper>
            </Stack>
          )}

          <div ref={messagesEndRef} />
        </Stack>
      </Box>

      {/* ACTIONS */}
      <Box sx={{ p: 2, borderTop: "1px solid #ddd", bgcolor: "#fff" }}>
        {!selectedModule && (
          <Stack direction="row" spacing={1} flexWrap="wrap">
            {modules.map((m) => (
              <Chip
                key={m.code}
                label={m.name}
                onClick={() => handleModuleSelect(m)}
                color="primary"
                variant="outlined"
              />
            ))}
          </Stack>
        )}

        {selectedModule && questions.length > 0 && !showFollowUp && (
          <Stack spacing={1}>
            {questions.slice(0, showCount).map((q, i) => (
              <Button
                key={i}
                variant="outlined"
                onClick={() => handleQuestionSelect(q)}
                sx={{ justifyContent: "flex-start" }}
              >
                {q}
              </Button>
            ))}

            {questions.length > showCount && (
              <Button size="small" onClick={() => setShowCount(showCount + 3)}>
                Show more
              </Button>
            )}
          </Stack>
        )}

        {showFollowUp && (
          <Stack direction="row" spacing={2}>
            <Button variant="contained" onClick={() => handleFollowUp("Yes")}>
              Yes
            </Button>
            <Button variant="outlined" onClick={() => handleFollowUp("No")}>
              No
            </Button>
          </Stack>
        )}
      </Box>

      {/* 🔹 Typing animation CSS */}
      <style>
        {`
          .dot {
            width: 6px;
            height: 6px;
            background: #555;
            border-radius: 50%;
            animation: blink 1.4s infinite both;
          }
          .dot:nth-child(1) { animation-delay: 0s; }
          .dot:nth-child(2) { animation-delay: 0.2s; }
          .dot:nth-child(3) { animation-delay: 0.4s; }

          @keyframes blink {
            0% { opacity: .2; }
            20% { opacity: 1; }
            100% { opacity: .2; }
          }
        `}
      </style>
    </Box>
  );
}
