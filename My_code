
const fetchBranches = async (searchTerm) => {
  try {
    setBranchLoading(true);

    const result = await callApi(
      `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(
        searchTerm
      )}`,
      null,
      "GET"
    );

    setBranches(result?.data || []);
  } catch (error) {
    console.error(error);
  } finally {
    setBranchLoading(false);
  }
};




<Grid container spacing={2}>
  <Grid size={{ xs: 6 }}>
    <Autocomplete
      options={branches}
      loading={branchLoading}
      filterOptions={(x) => x}
      getOptionLabel={(option) =>
        `${option.code}-${option.name}`
      }
      value={
        branches.find(
          (b) => b.code === form.BRANCH_CODE
        ) || null
      }
      onInputChange={(event, value) => {
        if (value && value.length >= 2) {
          fetchBranches(value);
        }
      }}
      onChange={(event, value) => {
        setForm({
          ...form,
          BRANCH_CODE: value?.code || "",
        });

        clearFieldError("BRANCH_CODE");
      }}
      renderInput={(params) => (
        <TextField
          {...params}
          label="Branch *"
          error={!!errors.BRANCH_CODE}
          helperText={errors.BRANCH_CODE}
        />
      )}
    />
  </Grid>

  <Grid size={{ xs: 6 }}>
    {/* Existing Role Dropdown */}
  </Grid>
</Grid>




