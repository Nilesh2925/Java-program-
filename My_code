@Override
@Transactional
public int updateCurrencyUpdatedAt(CurrencyUpdateRequestDTO request) {

    if (request.getCurrencyCodes() == null || request.getCurrencyCodes().isEmpty()) {
        throw new IllegalArgumentException("Currency code list cannot be empty");
    }

    // Fetch all currencies from Currency Master
    List<CurrencyMasterModel> currencies =
            (List<CurrencyMasterModel>) currencyMasterRepo.findAllById(request.getCurrencyCodes());

    // Save current data into Currency Rate Change table
    for (CurrencyMasterModel currency : currencies) {

        CurrencyRateChange history = new CurrencyRateChange();

        history.setCurrencyCode(currency.getCurrencyCode());
        history.setCurrencyRate(currency.getCurrencyRate());

        // No need to set rateChangeDate.
        // Your @PrePersist will automatically set LocalDateTime.now()

        currencyRateChangeRepo.save(history);
    }

    // Update UPDATED_AT in Currency Master
    return currencyMasterRepo.updateCurrencyUpdatedAt(request.getCurrencyCodes());
}
