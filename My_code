import {
  Drawer,
  Box,
  Typography,
  IconButton,
  Divider,
  Stack,
  Button,
  Chip,
  CircularProgress,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import SmartToyIcon from "@mui/icons-material/SmartToy";
import { useEffect, useState } from "react";

export default function AiAssistant({
  open,
  onClose,
  userMenus = [],
}) {
  const [step, setStep] = useState("HOME");
  const [selectedModule, setSelectedModule] = useState("");
  const [typing, setTyping] = useState(false);
  const [answer, setAnswer] = useState("");

  /* ---------------- ALLOWED MODULES ---------------- */

  // userMenus MUST be an array like response.roleData.rootMenus
  const allowedModules = Array.isArray(userMenus)
    ? userMenus
        .filter((m) => m.hasChildren)
        .map((m) => m.title)
    : [];

  /* ---------------- DUMMY QUESTIONS ---------------- */

  const MODULE_QUESTIONS = {
    "Circle Management": [
      "How to create a circle?",
      "How to approve a circle request?",
      "How to view circle details?",
    ],
    "CGL Management": [
      "How to create a CGL?",
      "How to approve a CGL request?",
      "Where can I view CGL details?",
    ],
    "Branch Management": [
      "How to create a branch?",
      "How to approve branch request?",
      "How to view branch details?",
    ],
  };

  const ANSWERS = {
    "How to create a circle?":
      "Go to Circle Management → Click Create → Enter details → Submit for approval.",
    "How to approve a circle request?":
      "Navigate to Circle Requests → Review → Approve or Reject.",
    "How to view circle details?":
      "Use View Circle Details screen and search the circle.",
    "How to create a CGL?":
      "Go to CGL Management → Create CGL → Fill details → Submit.",
    "How to approve a CGL request?":
      "Navigate to CGL Requests and approve pending requests.",
    "Where can I view CGL details?":
      "Use View CGL Details option and search the CGL.",
    "How to create a branch?":
      "Go to Branch Management → Create → Fill branch details → Submit.",
    "How to approve branch request?":
      "Navigate to Branch Requests and approve or reject.",
    "How to view branch details?":
      "Use View Branch Details option to search and view branch info.",
  };

  /* ---------------- HANDLERS ---------------- */

  const handleModuleSelect = (module) => {
    setSelectedModule(module);
    setStep("QUESTIONS");
  };

  const handleQuestionSelect = (question) => {
    setTyping(true);
    setAnswer("");
    setStep("ANSWER");

    // simulate backend delay
    setTimeout(() => {
      setTyping(false);
      setAnswer(ANSWERS[question]);
    }, 1200);
  };

  const reset = () => {
    setStep("HOME");
    setSelectedModule("");
    setAnswer("");
    setTyping(false);
  };

  /* ---------------- RENDER ---------------- */

  return (
    <Drawer
      anchor="right"
      open={open}
      onClose={onClose}
      PaperProps={{
        sx: {
          width: 420,
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          p: 2,
          display: "flex",
          alignItems: "center",
          gap: 1,
        }}
      >
        <SmartToyIcon color="primary" />
        <Typography fontWeight={600} flex={1}>
          FinCore Assistant
        </Typography>
        <IconButton onClick={onClose}>
          <CloseIcon />
        </IconButton>
      </Box>

      <Divider />

      {/* BODY */}
      <Box sx={{ flex: 1, p: 2, overflowY: "auto" }}>
        {/* HOME */}
        {step === "HOME" && (
          <Stack spacing={2}>
            <Typography>How can I help you?</Typography>
            <Button
              variant="contained"
              onClick={() => setStep("MODULES")}
            >
              Select Module
            </Button>
            <Button variant="outlined" disabled>
              FAQs (Coming Soon)
            </Button>
          </Stack>
        )}

        {/* MODULES */}
        {step === "MODULES" && (
          <Stack spacing={1.5}>
            <Typography fontWeight={600}>
              Select a module
            </Typography>

            {allowedModules.length === 0 && (
              <Typography color="error">
                No modules available for this user
              </Typography>
            )}

            {allowedModules.map((m) => (
              <Chip
                key={m}
                label={m}
                clickable
                onClick={() => handleModuleSelect(m)}
              />
            ))}

            <Button size="small" onClick={reset}>
              ← Back
            </Button>
          </Stack>
        )}

        {/* QUESTIONS */}
        {step === "QUESTIONS" && (
          <Stack spacing={1.5}>
            <Typography fontWeight={600}>
              {selectedModule}
            </Typography>

            {(MODULE_QUESTIONS[selectedModule] || []).map(
              (q) => (
                <Chip
                  key={q}
                  label={q}
                  clickable
                  onClick={() =>
                    handleQuestionSelect(q)
                  }
                />
              )
            )}

            <Button
              size="small"
              onClick={() => setStep("MODULES")}
            >
              ← Change Module
            </Button>
          </Stack>
        )}

        {/* ANSWER */}
        {step === "ANSWER" && (
          <Stack spacing={2}>
            {typing ? (
              <Stack direction="row" spacing={1}>
                <CircularProgress size={18} />
                <Typography variant="body2">
                  Assistant is typing…
                </Typography>
              </Stack>
            ) : (
              <Typography variant="body2">
                {answer}
              </Typography>
            )}

            <Button size="small" onClick={reset}>
              Start Again
            </Button>
          </Stack>
        )}
      </Box>
    </Drawer>
  );
}
