package com.tcs.userservice.dto;

import com.fasterxml.jackson.annotation.JsonIgnoreProperties;

import com.fincore.commonutilities.util.MaskingUtil;
import jakarta.validation.Valid;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Pattern;
import lombok.Data;

@Data
@JsonIgnoreProperties(ignoreUnknown = true)
public class UserRequestCreateDto {
    @NotBlank
    @Pattern(regexp = "^(CREATE|MODIFY|LOCK|UNLOCK|DELETE|CANCEL)$")
    private String requestType;

    @NotBlank
    @Pattern(regexp = "^(v|tcs)?\\d{7}$", message = "Invalid User Id format.")
    private String targetUserId;

    @Valid
    @NotNull
    private UserPayloadDto requestPayload;

    @Override
    public String toString() {
        return "UserRequestCreateDto(" +
                "requestType=" + requestType +
                ", targetUserId=" + targetUserId +
                ", requestPayload=" + MaskingUtil.maskJsonString(String.valueOf(requestPayload)) +
                ")";
    }
