import {
  Box,
  Typography,
  Chip,
  Stack,
  Paper,
  Divider,
  Button,
} from "@mui/material";
import { useSelector } from "react-redux";
import { useEffect, useRef, useState } from "react";

/* ------------------ DUMMY QUESTIONS (REPLACE WITH API LATER) ------------------ */
const QUESTION_BANK = {
  "Circle Management": [
    {
      q: "What is Circle Management?",
      a: "Circle Management is used to create and manage operational circles within the system.",
    },
    {
      q: "How do I create a circle?",
      a: "Go to Circle Management → Create → Enter details → Submit for approval.",
    },
    {
      q: "Who can approve circle requests?",
      a: "Only authorized users with approval rights can approve or reject requests.",
    },
    {
      q: "Can I edit an approved circle?",
      a: "Yes, but changes must be raised as a new request.",
    },
  ],
  "CGL Management": [
    {
      q: "What is CGL?",
      a: "CGL stands for Central General Ledger used for accounting purposes.",
    },
    {
      q: "How do I create a CGL?",
      a: "Navigate to CGL Management → Create → Fill required fields → Submit.",
    },
    {
      q: "Where can I see my CGL requests?",
      a: "You can view them under the My Requests tab.",
    },
  ],
};

/* ------------------ TYPING DOTS ------------------ */
const TypingDots = () => (
  <Typography variant="body2" sx={{ fontStyle: "italic" }}>
    <span className="dot">.</span>
    <span className="dot">.</span>
    <span className="dot">.</span>
  </Typography>
);

/* ------------------ MAIN COMPONENT ------------------ */
export default function AiAssistant() {
  const allowedMenus = useSelector((state) => state.menus.menus);

  const [chat, setChat] = useState([]);
  const [selectedModule, setSelectedModule] = useState(null);
  const [showAllQuestions, setShowAllQuestions] = useState(false);
  const [isTyping, setIsTyping] = useState(false);
  const [askAgain, setAskAgain] = useState(false);

  const bottomRef = useRef(null);

  /* Auto scroll */
  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [chat, isTyping]);

  /* Handle module select */
  const handleModuleSelect = (module) => {
    setSelectedModule(module);
    setShowAllQuestions(false);
    setAskAgain(false);
    setChat([
      {
        from: "bot",
        text: `You selected ${module}. Please choose a question.`,
      },
    ]);
  };

  /* Handle question click */
  const handleQuestionClick = (item) => {
    setChat((prev) => [...prev, { from: "user", text: item.q }]);
    setIsTyping(true);

    setTimeout(() => {
      setIsTyping(false);
      setChat((prev) => [
        ...prev,
        { from: "bot", text: item.a },
        {
          from: "bot",
          text: "Would you like to ask another question?",
          action: "yesno",
        },
      ]);
      setAskAgain(true);
    }, 1200);
  };

  const questions =
    selectedModule && QUESTION_BANK[selectedModule]
      ? QUESTION_BANK[selectedModule]
      : [];

  return (
    <Box sx={{ height: "100%", p: 2, overflowY: "auto" }}>
      {/* BOT WELCOME */}
      {chat.length === 0 && (
        <Typography variant="body1" mb={2}>
          👋 Hi, I’m your FinCore Assistant. Please select a module.
        </Typography>
      )}

      {/* MODULE SELECTION */}
      {!selectedModule && (
        <Stack direction="row" spacing={1} flexWrap="wrap">
          {allowedMenus.map((m) => (
            <Chip
              key={m.id}
              label={m.title}
              clickable
              color="primary"
              onClick={() => handleModuleSelect(m.title)}
            />
          ))}
        </Stack>
      )}

      {/* CHAT MESSAGES */}
      <Stack spacing={1} mt={2}>
        {chat.map((msg, idx) => (
          <Box
            key={idx}
            alignSelf={msg.from === "user" ? "flex-end" : "flex-start"}
            sx={{
              backgroundColor:
                msg.from === "user" ? "primary.main" : "grey.200",
              color: msg.from === "user" ? "white" : "black",
              px: 2,
              py: 1,
              borderRadius: 2,
              maxWidth: "80%",
            }}
          >
            <Typography variant="body2">{msg.text}</Typography>

            {msg.action === "yesno" && (
              <Stack direction="row" spacing={1} mt={1}>
                <Button
                  size="small"
                  variant="contained"
                  onClick={() => {
                    setAskAgain(false);
                    setChat((prev) => [
                      ...prev,
                      {
                        from: "bot",
                        text: "Please select another question.",
                      },
                    ]);
                  }}
                >
                  Yes
                </Button>
                <Button
                  size="small"
                  variant="outlined"
                  onClick={() => {
                    setAskAgain(false);
                    setChat((prev) => [
                      ...prev,
                      {
                        from: "bot",
                        text:
                          "Thank you for using FinCore Assistant. Have a great day!",
                      },
                    ]);
                  }}
                >
                  No
                </Button>
              </Stack>
            )}
          </Box>
        ))}

        {isTyping && <TypingDots />}
        <div ref={bottomRef} />
      </Stack>

      {/* QUESTIONS */}
      {selectedModule && !askAgain && (
        <>
          <Divider sx={{ my: 2 }} />
          <Typography variant="subtitle2">Questions</Typography>

          {questions
            .slice(0, showAllQuestions ? questions.length : 3)
            .map((item, i) => (
              <Paper
                key={i}
                onClick={() => handleQuestionClick(item)}
                sx={{
                  p: 1,
                  mt: 1,
                  cursor: "pointer",
                  "&:hover": { backgroundColor: "grey.100" },
                }}
              >
                <Typography variant="body2">{item.q}</Typography>
              </Paper>
            ))}

          {questions.length > 3 && !showAllQuestions && (
            <Button size="small" onClick={() => setShowAllQuestions(true)}>
              Show more
            </Button>
          )}
        </>
      )}
    </Box>
  );
}
