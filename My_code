
useEffect(() => {
  const loadSelectedBranch = async () => {
    if (!open || !isEdit || !form.BRANCH_CODE || form.BRANCH_NAME) return;

    try {
      setBranchLoading(true);

      const branchCode = String(form.BRANCH_CODE).padStart(5, "0");

      const response = await callApi(
        `/CM/common-master/branches-code-name-only?q=${branchCode}&circleCode=`,
        {},
        "GET"
      );

      if (response?.data?.length) {
        const branch = {
          ...response.data[0],
          code: String(response.data[0].code).trim(),
          name: response.data[0].name.trim(),
        };

        setBranchOptions([branch]);

        setForm((prev) => ({
          ...prev,
          BRANCH_NAME: branch.name,
        }));
      }
    } catch (error) {
      console.error(error);
    } finally {
      setBranchLoading(false);
    }
  };

  loadSelectedBranch();
}, [open]);
