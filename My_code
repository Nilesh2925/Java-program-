import React, { useEffect, useMemo, useState, useCallback } from "react";
import {
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  Typography,
  Tooltip,
  IconButton,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import useApi from "../../../hooks/useApi";
import CancelIcon from "@mui/icons-material/Cancel";
import VisibilityIcon from "@mui/icons-material/Visibility";
import AddBoxIcon from "@mui/icons-material/AddBox";
import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import PendingActionsIcon from "@mui/icons-material/PendingActions";
import BlockFlippedIcon from "@mui/icons-material/BlockFlipped";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import GppBadIcon from "@mui/icons-material/GppBad";
import { getPermissions } from "../../../utils/CommonUtilities";
import CustomChip from "../../../utils/CustomChip";
import InfoIcon from "@mui/icons-material/Info";
import ViewMyRequestDialog from "../../common/ViewMyRequestDialog";
import { useSelector } from "react-redux";
function CustomNoRowsOverlay() {
  return (
    <Stack height="100%" alignItems="center" justifyContent="center">
      <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
      <Typography variant="h6">No Role Requests Found</Typography>
      <Typography>You have not created any Role requests.</Typography>
    </Stack>
  );
}

export default function UserManagementTab2() {
  const { callApi } = useApi();
  const selectedMenu = useSelector((state) => state.menus.selectedMenuItem);
  const permissions = getPermissions(selectedMenu);
  const showSnackBar = useCustomSnackbar();
  const [isLoading, setIsLoading] = useState(true);
  const [rows, setRows] = useState([]);
  const [confirmDialog, setConfirmDialog] = useState(false);
  const [requestId, setRequestId] = useState(null);
  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);

  const fetchData = useCallback(async () => {
    try {
      const response = await callApi("/UM/user/my-requests", null, "GET");
      console.log(response);
      if (response?.result) {
        const res = response?.result?.myRequests;
        const result = res.map((row) => {
          let parsedPayload = {};
          parsedPayload = row.requestPayload
            ? JSON.parse(row.requestPayload)
            : {};

          return {
            ...parsedPayload,
            ...row,
          };
        });
        setRows(result);
      } else {
        setRows([]);
      }
    } catch (error) {
      console.error(error);
    } finally {
      setIsLoading(false);
    }
  }, [callApi]);
  useEffect(() => {
    fetchData();
  }, []);

  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        actionFlag: "CANCEL",
        remarks: "User canceled this Request",
      };
      const response = await callApi(
        "/UM/user/cancel-request",
        payload,
        "POST",
      );
      console.log(response);
      if (response?.result?.status) {
        showSnackBar(
          `Request Id ${requestId} Cancelled Successfully.`,
          "success",
        );
      } else {
        showSnackBar(
          response?.result?.message
            ? response?.result?.message
            : "Failed to process your cancel request, Kindly try again",
          "error",
        );
      }
    } catch (error) {
      console.log(error);
    } finally {
      fetchData();
      setConfirmDialog(false);
    }
  };

  const handleViewClick = (data) => {
    console.log(data);
    const {
      requestId,
      requestStatus,
      requestDate,
      userId,
      accountStatus,
      firstName,
      middleName,
      lastName,
      email,
      phoneNumber,
      branch,
      roleName,
      requestorUserId,
      requestType,
      approvalDate,
      approverId,
      rejectionReason,
    } = data;
    const showData = {
      userId,
      roleName,
      firstName,
      middleName,
      lastName,
      email,
      branch,
      phoneNumber,
    };
    data.id = requestId;
    data.reqDate = requestDate;
    data.changeType = requestType === "CREATE" ? "ADD" : requestType;
    data.reqStatus = requestStatus;
    data.creatorId = requestorUserId;
    data.executorId = approverId;
    data.executorRemarks = rejectionReason;
    data.executionDate = approvalDate;

    data.showData = showData;
    setViewData(data);
    setViewOpen(true);
  };

  const columns = useMemo(
    () => [
      {
        field: "requestId",
        headerName: "Request Id",
        flex: 0.5,
        minWidth: 150,
      },
      { field: "userId", headerName: "User ID", flex: 0.5, minWidth: 150 },
      {
        field: "userName",
        headerName: "User Name",
        flex: 1.3,
        minWidth: 250,
        renderCell: (p) =>
          `${p.row.firstName} ${p?.row?.middleName || ""} ${
            p?.row?.lastName || ""
          }`,
      },
      {
        field: "requestType",
        headerName: "Request Type",
        flex: 0.5,
        minWidth: 150,
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => {
          const val = params.value;
          const color =
            val === "CREATE"
              ? "success"
              : val === "DELETE"
                ? "error"
                : "warning";
          const icon =
            val === "ADD" ? (
              <AddBoxIcon />
            ) : val === "DELETE" ? (
              <AutoDeleteIcon />
            ) : (
              <EditDocumentIcon />
            );
          return (
            <CustomChip
              variant="outlined"
              icon={icon}
              label={
                val === "CREATE"
                  ? "Created"
                  : val === "DELETE"
                    ? "Deleted"
                    : "Modified"
              }
              color={color}
            />
          );
        },
      },

      {
        field: "requestDate",
        headerName: "Requested Date",
        flex: 1,
        minWidth: 250,
        // align: "center",
        // headerAlign: "center",
        renderCell: (params) => {
          const isoString = params.value;
          if (!isoString) return null;

          const date = new Date(isoString);
          return (
            <Typography component="span">
              {date.toLocaleString("en-IN", {
                year: "numeric",
                month: "short",
                day: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: true,
              })}
            </Typography>
          );
        },
      },

      // ... rest of your DataGrid setup
      {
        field: "requestStatus",
        headerName: "Status",
        flex: 1,
        minWidth: 120,
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Box
            sx={{
              color:
                params.value === "REJECTED"
                  ? "error.main"
                  : params.value === "ACCEPTED"
                    ? "success.dark"
                    : "warning.main",
              fontWeight: "bold",
            }}
          >
            <CustomChip
              variant="outlined"
              icon={
                params.value === "REJECTED" ? (
                  <BlockFlippedIcon />
                ) : params.value === "ACCEPTED" ? (
                  <CheckCircleIcon />
                ) : params.value === "CANCELLED" ? (
                  <GppBadIcon />
                ) : (
                  <PendingActionsIcon />
                )
              }
              label={
                params.value === "REJECTED"
                  ? "Rejected"
                  : params.value === "ACCEPTED"
                    ? "Approved"
                    : params.value === "CANCELLED"
                      ? "Cancelled"
                      : "Pending"
              }
              sx={{
                color:
                  params.value === "REJECTED"
                    ? "error.dark"
                    : params.value === "ACCEPTED"
                      ? "success.dark"
                      : params.value === "CANCELLED"
                        ? "primary.dark"
                        : "warning.light",

                "& .MuiChip-icon": {
                  color:
                    params.value === "REJECTED"
                      ? "error.dark"
                      : params.value === "ACCEPTED"
                        ? "success.dark"
                        : params.value === "CANCELLED"
                          ? "primary.dark"
                          : "warning.light",
                },
              }}
            />
          </Box>
        ),
      },
      {
        field: "action",
        headerName: "Action",
        flex: 0.6,
        minWidth: 120,
        align: "center",
        headerAlign: "center",
        filterable: false,
        sortable: false,
        disableColumnMenu: true,
        renderCell: (params) => (
          <Stack
            direction="row"
            spacing={1}
            justifyContent="center"
            alignItems="center"
            height="100%"
          >
            {permissions.view && (
              <Tooltip title="View">
                <IconButton
                  // color="primary"
                  onClick={() => handleViewClick(params.row)}
                >
                  <VisibilityIcon />
                </IconButton>
              </Tooltip>
            )}
            {params.row.requestStatus === "PENDING" && permissions.cancel && (
              <Tooltip title={"Cancel Request"}>
                <IconButton
                  onClick={() => {
                    setConfirmDialog(true);
                    setRequestId(params.row.requestId);
                  }}
                >
                  <CancelIcon fontSize="inherit" />
                </IconButton>
              </Tooltip>
            )}
          </Stack>
        ),
      },
    ],
    [],
  );

  const filteredColumns = useMemo(() => {
    console.log(permissions);
    if (permissions.view || permissions.cancel) {
      return columns;
    }
    // Otherwise, filter out the column where field name is 'action'.
    else {
      return columns.filter((column) => column.field !== "action");
    }
  }, [columns, permissions]);

  return (
    <>
      <Box>
        <DataGrid
          rows={rows}
          loading={isLoading}
          columns={filteredColumns}
          disableRowSelectionOnClick
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
          }}
          getRowId={(row) => row.requestId}
          slots={{
            noRowsOverlay: CustomNoRowsOverlay,
          }}
        />
      </Box>

      <ViewMyRequestDialog
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />
      <Dialog
        open={confirmDialog}
        onClose={() => {
          setConfirmDialog(false);
        }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>
          Cancel Request ID: {requestId}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request Please confirm ?
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmDialog(false);
            }}
            variant="outlined"
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
