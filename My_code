import {
  Box,
  Typography,
  Paper,
  Stack,
  Button,
  TextField,
  useTheme,
} from "@mui/material";
import { useEffect, useRef, useState } from "react";
import { useSelector } from "react-redux";

/* ================= TEMP DATA (REPLACE WITH BE LATER) ================= */
const QUESTION_BANK = {
  "Circle Management": [
    {
      q: "What is Circle Management?",
      a: "Circle Management allows you to create and manage operational circles in FinCore.",
    },
    {
      q: "How do I create a circle?",
      a: "Navigate to Circle Management, click Create, fill required details, and submit for approval.",
    },
    {
      q: "Who can approve circle requests?",
      a: "Only authorized users can approve or reject circle requests.",
    },
  ],
  "CGL Management": [
    {
      q: "What is CGL?",
      a: "CGL stands for Central General Ledger used for accounting purposes.",
    },
    {
      q: "How do I create a CGL?",
      a: "Go to CGL Management, click Create, fill details and submit.",
    },
  ],
};

/* ================= TYPING DOTS ================= */
const TypingDots = () => (
  <Box sx={{ display: "flex", gap: 0.5 }}>
    {[1, 2, 3].map((i) => (
      <Box
        key={i}
        sx={{
          width: 6,
          height: 6,
          borderRadius: "50%",
          backgroundColor: "grey.500",
          animation: "blink 1.4s infinite both",
          animationDelay: `${i * 0.2}s`,
        }}
      />
    ))}
    <style>
      {`
        @keyframes blink {
          0% { opacity: .2 }
          20% { opacity: 1 }
          100% { opacity: .2 }
        }
      `}
    </style>
  </Box>
);

export default function AiAssistant() {
  const theme = useTheme();
  const scrollRef = useRef(null);

  /* Redux menus */
  const menus = useSelector((state) => state.menus?.menus || []);
  const allowedModules = menus.map((m) => m.title);

  /* Chat state */
  const [chat, setChat] = useState([
    { from: "bot", text: "Hello 👋 I’m FinCore Assistant. How can I help you?" },
  ]);

  const [stage, setStage] = useState("HOME"); // HOME | MODULES | QUESTIONS
  const [selectedModule, setSelectedModule] = useState(null);
  const [questions, setQuestions] = useState([]);
  const [typing, setTyping] = useState(false);

  /* Search (NEW – independent) */
  const [search, setSearch] = useState("");

  useEffect(() => {
    scrollRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [chat, typing]);

  const botReply = (text, delay = 900) => {
    setTyping(true);
    setTimeout(() => {
      setTyping(false);
      setChat((p) => [...p, { from: "bot", text }]);
    }, delay);
  };

  /* ================= EXISTING FLOW ================= */

  const handleSelectModuleClick = () => {
    setChat((p) => [...p, { from: "user", text: "Select Module" }]);
    setStage("MODULES");
  };

  const handleModuleSelect = (module) => {
    setSelectedModule(module);
    setChat((p) => [...p, { from: "user", text: module }]);
    const qs = QUESTION_BANK[module] || [];
    setQuestions(qs);
    setStage("QUESTIONS");
    botReply(`Here are some common questions related to ${module}.`);
  };

  const handleQuestionClick = (qObj) => {
    setChat((p) => [...p, { from: "user", text: qObj.q }]);
    botReply(qObj.a, 1200);
    setTimeout(() => {
      botReply("Would you like to ask another question?");
    }, 2300);
  };

  const handleYesNo = (yes) => {
    setChat((p) => [...p, { from: "user", text: yes ? "Yes" : "No" }]);
    yes
      ? botReply("Please select another question.")
      : botReply("Thank you for using FinCore Assistant.");
  };

  /* ================= SEARCH (ADDITIONAL) ================= */

  const allQuestions = Object.values(QUESTION_BANK).flat();
  const searchResults =
    search.trim().length > 0
      ? allQuestions.filter((q) =>
          q.q.toLowerCase().includes(search.toLowerCase())
        )
      : [];

  /* ================= UI ================= */

  return (
    <Box sx={{ height: "100%", display: "flex", flexDirection: "column", p: 2 }}>
      {/* CHAT AREA */}
      <Stack spacing={1.5} sx={{ flex: 1, overflowY: "auto" }}>
        {chat.map((msg, i) => (
          <Box
            key={i}
            sx={{
              display: "flex",
              justifyContent: msg.from === "user" ? "flex-end" : "flex-start",
            }}
          >
            <Paper
              sx={{
                p: 1.5,
                maxWidth: "75%",
                backgroundColor:
                  msg.from === "user"
                    ? theme.palette.primary.light
                    : theme.palette.grey[100],
              }}
            >
              <Typography variant="body2">{msg.text}</Typography>
            </Paper>
          </Box>
        ))}

        {typing && (
          <Paper sx={{ p: 1.5, width: "fit-content" }}>
            <TypingDots />
          </Paper>
        )}

        {/* HOME OPTIONS */}
        {stage === "HOME" && (
          <Paper sx={{ p: 2 }}>
            <Stack spacing={1}>
              <Button variant="outlined" onClick={handleSelectModuleClick}>
                Select Module
              </Button>
              <Button variant="outlined">FAQs</Button>
            </Stack>
          </Paper>
        )}

        {/* MODULES */}
        {stage === "MODULES" && (
          <Paper sx={{ p: 2 }}>
            <Typography variant="subtitle2" gutterBottom>
              Select a module
            </Typography>
            <Stack direction="row" flexWrap="wrap" gap={1}>
              {allowedModules.map((m) => (
                <Button
                  key={m}
                  size="small"
                  variant="outlined"
                  onClick={() => handleModuleSelect(m)}
                >
                  {m}
                </Button>
              ))}
            </Stack>
          </Paper>
        )}

        {/* QUESTIONS (MODULE FLOW – SAME AS BEFORE) */}
        {stage === "QUESTIONS" && (
          <Paper sx={{ p: 2 }}>
            <Stack spacing={1}>
              {questions.map((q, i) => (
                <Button
                  key={i}
                  variant="text"
                  onClick={() => handleQuestionClick(q)}
                >
                  {q.q}
                </Button>
              ))}
            </Stack>
          </Paper>
        )}

        {/* YES / NO */}
        {chat.at(-1)?.text ===
          "Would you like to ask another question?" && (
          <Stack direction="row" spacing={1}>
            <Button variant="outlined" onClick={() => handleYesNo(true)}>
              Yes
            </Button>
            <Button variant="outlined" onClick={() => handleYesNo(false)}>
              No
            </Button>
          </Stack>
        )}

        <div ref={scrollRef} />
      </Stack>

      {/* 🔍 SEARCH – ADDITIONAL, AT BOTTOM */}
      <Box sx={{ mt: 1 }}>
        <TextField
          fullWidth
          size="small"
          placeholder="Search questions..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />

        {searchResults.length > 0 && (
          <Paper sx={{ mt: 1, maxHeight: 200, overflowY: "auto" }}>
            <Stack>
              {searchResults.map((q, i) => (
                <Button
                  key={i}
                  variant="text"
                  onClick={() => {
                    setSearch("");
                    handleQuestionClick(q);
                  }}
                  sx={{ justifyContent: "flex-start" }}
                >
                  {q.q}
                </Button>
              ))}
            </Stack>
          </Paper>
        )}
      </Box>
    </Box>
  );
}
