	@Override
	public PaginatedResponseDto<CommonRequestDto> searchLhoTransfers(SearchRequest request) {
		log.info("Searching Common Requests for REQ_TYPE: YEAR_END_PROFIT_TRANSFER");

		// Set up Pagination & Sorting
		Sort.Direction direction = (request.getSortOrder() != null && request.getSortOrder().equalsIgnoreCase("DESC"))
				? Sort.Direction.DESC
				: Sort.Direction.ASC;
		String sortField = (request.getSortField() != null) ? request.getSortField() : "requestDate";

		PageRequest pageRequest = PageRequest.of(request.getPage(), request.getSize(), Sort.by(direction, sortField));

		// Business Rule: Hard filter for LHO_TRANSFER
		Specification<CommonRequest> lhoTypeSpec = (root, query, cb) -> cb.equal(root.get("requestType"),
				"YEAR_END_PROFIT_TRANSFER");

		// Combine with dynamic UI filters using your GenericSpecification
		Specification<CommonRequest> finalSpec = lhoTypeSpec.and(GenericSpecification.build(request.getFilters()));

		Page<CommonRequest> page = commonRequestRepository.findAll(finalSpec, pageRequest);

		if (page.isEmpty()) {
			throw new NoDataFoundException("No YEAR_END_PROFIT records found.");
		}

		List<CommonRequestDto> dtoList = page.getContent().stream()
				.map(this::mapToRequestDto)
				.toList();

		return new PaginatedResponseDto<>(
				page.getNumber(),
				page.getTotalPages(),
				page.getSize(),
				page.getTotalElements(),
				direction.name(),
				dtoList);
	}

	@Override
	public CommonRequestDto getLhoTransferById(Long id) {
		CommonRequest entity = commonRequestRepository.findById(id)
				.orElseThrow(() -> new NoDataFoundException("Request " + id + " not found."));

		// Enforce type check for security
		if (!"YEAR_END_PROFIT_TRANSFER".equalsIgnoreCase(entity.getRequestType())) {
			throw new IllegalArgumentException("Access Denied: Record is not an LHO Transfer.");
		}

		return mapToRequestDto(entity);
	}

