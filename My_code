// role payload dto
package com.tcs.userservice.dto;

import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import jakarta.validation.Valid;
import jakarta.validation.constraints.*;
import lombok.Data;

import java.util.List;

@Data
public class RolePayloadDto {

    private String roleId;

    @NotBlank(message = "Role Name is required.")
    @Size(min = 3, max = 20)
    @Pattern(regexp = "^[a-zA-Z0-9 ,()&/\\-]+$", message = "Invalid Role Name. Only alphabets, numbers, spaces and ,()&/- are allowed).")
    private String roleName;

    @Size(min = 5, max = 200)
    @NotBlank(message = "Description is required.")
    @Pattern(regexp = "^(?!.* {2})[a-zA-Z0-9 ,()&/\\-]+$",
            message = "Invalid Description. Only single spaces and ,()&/- are allowed.")
    private String description;

    @NotBlank(message = "Role Status is required.")
    @Pattern(regexp = "^(ACTIVE|INACTIVE|BLOCKED)$", message = "Role status must be ACTIVE or INACTIVE.")
    private String roleStatus;

    @NotEmpty(message = "At least one permission must be selected.")
    @Valid
    private List<PermissionDto> permissions;

    @Data
    @JsonIgnoreProperties(ignoreUnknown = true)
    public static class PermissionDto {
        @NotNull(message = "Permission ID is required.")
        private Integer id;

        @NotBlank(message = "Permission Title is required.")
        @Pattern(regexp = "^[a-zA-Z0-9 ,()&/\\-]{3,50}$", message = "Invalid Permission Title format.")
        private String title;

        private Integer order;
        private String icon;
        private String description;
        private String menuSubmenu;
    }
}

