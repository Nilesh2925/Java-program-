package com.tcs.fincore.CommonMasterService.model;

import jakarta.persistence.*;
import lombok.*;
import org.hibernate.annotations.CreationTimestamp;
import java.time.LocalDateTime;

@Getter
@Setter
@Entity
@AllArgsConstructor
@NoArgsConstructor
@Builder
@Table(name = "COMMON_REQ")
public class CommonRequest {

    @Id
    @GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "common_req_seq")
    @SequenceGenerator(name = "common_req_seq", sequenceName = "COMMON_REQ_SEQ", allocationSize = 1)
    @Column(name = "REQ_ID")
    private Long id;

    @Column(name = "REQ_TYPE", length = 20, nullable = false)
    private String requestType;

    @Column(name = "CHANGE_TYPE", length = 2, nullable = false)
    private String changeType;

    @Column(name = "REQ_STATUS", length = 2, nullable = false)
    private String status;

    @CreationTimestamp
    @Column(name = "REQ_DATE", nullable = false, updatable = false)
    private LocalDateTime requestDate;

    @Column(name = "CREATOR_ID", length = 12, nullable = false)
    private String creatorId;

    @Column(name = "EXECUTION_DATE")
    private LocalDateTime executionDate;

    @Lob
    @Column(name = "EXECUTION_REMARKS")
    private String executionRemarks;

    @Column(name = "EXECUTOR_ID", length = 12)
    private String executorId;

    @Column(name = "EXECUTOR_REMARKS", length = 500)
    private String executorRemarks;

    @Lob
    @Column(name = "PAYLOAD")
    private String payload;

    @Column(name = "TARGET_ID", length = 4000)
    private String targetId;

    @Column(name = "CREATOR_REMARKS", length = 500)
    private String creatorRemarks;
}
