		return balanceStreamingExportService.export(
				request, userId);
	}


	@Override
	public PaginatedResponseDTO<GLBalanceResponseDTO> getGlBalanceReport(
			String startDate, String endDate, String circle, String branch, String cgl, Integer page, Integer size,
			String currency) {

		Pageable pageable = PageRequest.of(page != null ? page : 0, size != null ? size : 10);

		Page<GLBalanceProjection> pageResult = glBalanceRepository.findGlBalances(
				startDate, endDate, currency, circle, branch, cgl, pageable);

		List<GLBalanceResponseDTO> list = pageResult.getContent().stream()
				.map(this::toGlBalanceDto)
				.toList();

		return new PaginatedResponseDTO<>(
				pageResult.getNumber(),
				pageResult.getTotalPages(),
				pageResult.getSize(),
				pageResult.getTotalElements(),
				null,
				list, null);
	}

	// =========================================================
	// PRIVATE HELPER METHODS
	// =========================================================

	private GetResponseDTO mapToResponseDTO(
			GlTransactions txn,
			DateTimeFormatter formatter) {

		GetResponseDTO res = new GetResponseDTO();

		res.setDate(formatter.format(txn.getTransactionDate()));
		res.setJournalNumber(txn.getJournalId());
		res.setBatchId(txn.getBatchId());
		res.setSourceFlag(
				SourceFlagUtil.getSourceFlagDescription(
						txn.getSourceFlag()));

		res.setTransactionCount(txn.getTransactionCount());
		res.setParticulars(txn.getNarration());
		res.setPostDate(txn.getPostDate().toLocalDateTime());
		res.setTransactionId(txn.getTransactionId());

		double debit = txn.getDebitAmount() != null ? Math.abs(txn.getDebitAmount()) : 0;
		double credit = txn.getCreditAmount() != null ? Math.abs(txn.getCreditAmount()) : 0;

		res.setDebitAmount(debit);
		res.setCreditAmount(credit);

		return res;
	}

	/**
	 * Helper Method: Forces the date to Start of Day (00:00:00) in Asia/Kolkata
	 * regardless of Server TimeZone.
	 */
	private Date convertToStartOfDay(Date date) {
		if (date == null)
			return null;
		Calendar calendar = Calendar.getInstance(TimeZone.getTimeZone(ZONE_IST));
		calendar.setTime(date);
		calendar.set(Calendar.HOUR_OF_DAY, 0);
		calendar.set(Calendar.MINUTE, 0);
		calendar.set(Calendar.SECOND, 0);
		calendar.set(Calendar.MILLISECOND, 0);
		return calendar.getTime();
	}

	/**
	 * Helper Method: Forces the date to End of Day (23:59:59) in Asia/Kolkata
	 * regardless of Server TimeZone.
	 */
	private Date convertToEndOfDay(Date date) {
		if (date == null)
			return null;
		Calendar calendar = Calendar.getInstance(TimeZone.getTimeZone(ZONE_IST));
		calendar.setTime(date);
		calendar.set(Calendar.HOUR_OF_DAY, 23);
		calendar.set(Calendar.MINUTE, 59);
		calendar.set(Calendar.SECOND, 59);
		calendar.set(Calendar.MILLISECOND, 999);
		return calendar.getTime();
	}

	private GLBalanceResponseDTO toGlBalanceDto(GLBalanceProjection p) {
		return new GLBalanceResponseDTO(
				p.getCIRCLE_CODE(),
				p.getCIRCLE_NAME(),
				p.getBRANCH_NAME(),
				p.getBRANCH_CODE(),
				p.getCGL(),
				p.getCGL_DESCRIPTION(),
				p.getBALANCE_DATE(),
				p.getCURRENCY(),
				p.getTOTAL_BALANCE(),
				p.getTOTAL_INR_BALANCE());
	}

	private String getSortField(String field) {

		return switch (field) {

			case "date" -> "transactionDate";
			case "journalNumber" -> "journalId";
			case "batchId" -> "batchId";
			case "sourceFlag" -> "sourceFlag";
			case "particulars" -> "narration";
			case "postDate" -> "postDate";

			default -> "transactionDate";
		};
	}
}


package com.fincore.enquiry_service.repository;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.fincore.enquiry_service.dto.GLBalanceProjection;
import com.fincore.enquiry_service.model.GLBalance;

import java.time.LocalDate;
import java.util.Date;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;

@Repository
public interface GLBalanceRepository extends JpaRepository<GLBalance, Integer> {

	@Query(value = "SELECT * FROM GL_BALANCE WHERE TRUNC(BALANCE_DATE) = TO_DATE(:fromdate, 'dd/MM/YYYY') AND BRANCH_CODE = :branchCode AND CURRENCY = :currency AND CGL = :cgl FETCH FIRST 1 ROWS ONLY", nativeQuery = true)
	GLBalance getGlBalanceData(
			@Param("fromdate") String date,
			@Param("branchCode") String branchCode,
			@Param("currency") String currency,
			@Param("cgl") String cgl);

	Page<GLBalance> findByBranchAndCglAndCurrencyAndDateBetween(String branch, String cgl, String currency,
																LocalDate startDate, LocalDate endDate, Pageable pageable);

	@Query(value = """  
		SELECT 
			c.CIRCLE_CODE,
			c.CIRCLE_NAME,
			b.NAME AS BRANCH_NAME, 
			b.CODE AS BRANCH_CODE,
			g.CGL,  
			d.DESCRIPTION AS CGL_DESCRIPTION,
			g.BALANCE_DATE,
			g.CURRENCY,
			SUM(g.BALANCE) AS TOTAL_BALANCE, 
			SUM(g.INR_BALANCE) AS TOTAL_INR_BALANCE
		FROM 
			GL_BALANCE g
		INNER JOIN 
			BRANCH_MASTER b ON g.BRANCH_CODE = b.CODE
		LEFT JOIN
			CIRCLE_MASTER c ON b.CIRCLE_CODE = c.CIRCLE_CODE
		LEFT JOIN
			CGL_MASTER d ON g.CGL = d.CGL_NUMBER
		WHERE 
			g.BALANCE_DATE >= TO_DATE(:startDate,'DD/MM/YYYY') 
			AND g.BALANCE_DATE < TO_DATE(:endDate,'DD/MM/YYYY')
			AND g.CURRENCY = :currency
			AND (:v_circle IS NULL OR c.CIRCLE_CODE = :v_circle)
			AND (:v_branch IS NULL OR b.CODE = :v_branch)
			AND (:v_cgl IS NULL OR g.CGL = :v_cgl)
		GROUP BY 
			c.CIRCLE_CODE, c.CIRCLE_NAME, b.NAME, b.CODE, 
			g.CGL, d.DESCRIPTION, g.BALANCE_DATE, g.CURRENCY
    """, 
    countQuery = """
        SELECT count(*) FROM (
            SELECT g.CGL FROM GL_BALANCE g
            INNER JOIN BRANCH_MASTER b ON g.BRANCH_CODE = b.CODE
            LEFT JOIN CIRCLE_MASTER c ON b.CIRCLE_CODE = c.CIRCLE_CODE
            WHERE g.BALANCE_DATE >= TO_DATE(:startDate,'DD/MM/YYYY') 
                AND g.BALANCE_DATE < TO_DATE(:endDate,'DD/MM/YYYY')
				AND g.CURRENCY = :currency
                AND (:v_circle IS NULL OR c.CIRCLE_CODE = :v_circle)
                AND (:v_branch IS NULL OR b.CODE = :v_branch)
                AND (:v_cgl IS NULL OR g.CGL = :v_cgl)
            GROUP BY c.CIRCLE_CODE, c.CIRCLE_NAME, b.NAME, b.CODE, g.CGL, g.BALANCE_DATE, g.CURRENCY
        )
    """, nativeQuery = true)
	Page<GLBalanceProjection> findGlBalances(
		@Param("startDate") String startDate,
		@Param("endDate") String endDate,
		@Param("currency") String currency,
		@Param("v_circle") String circle,
		@Param("v_branch") String branch,
		@Param("v_cgl") String cgl,
		Pageable pageable
    );
}


