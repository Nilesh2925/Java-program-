import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Stack,
  Button,
  Chip,
  CircularProgress,
  Divider,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import SmartToyIcon from "@mui/icons-material/SmartToy";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import { useEffect, useState } from "react";

/**
 * PROPS EXPECTED:
 * open
 * onClose
 * userMenus -> response.roleData.rootMenus
 */
export default function AiAssistant({ open, onClose, userMenus = [] }) {
  const [step, setStep] = useState("HOME");
  const [modules, setModules] = useState([]);
  const [selectedModule, setSelectedModule] = useState(null);
  const [questions, setQuestions] = useState([]);
  const [answer, setAnswer] = useState("");
  const [typing, setTyping] = useState(false);

  // 🔹 Extract allowed modules from backend response
  useEffect(() => {
    const allowed = userMenus
      .filter((m) => m.hasChildren)
      .map((m) => m.title);
    setModules(allowed);
  }, [userMenus]);

  // 🔹 Dummy questions (replace later with API)
  const MODULE_QUESTIONS = {
    "Circle Management": [
      "How to create a circle?",
      "How to approve a circle request?",
      "How to view circle details?",
    ],
    "CGL Management": [
      "How to create a CGL?",
      "How to approve a CGL request?",
      "Where can I see CGL details?",
    ],
    "Branch Management": [
      "How to create a branch?",
      "How to approve branch requests?",
      "How to view branch details?",
    ],
  };

  const MODULE_ANSWERS = {
    "How to create a circle?":
      "Navigate to Circle Management, click Create, enter required details, and submit for approval.",
    "How to approve a circle request?":
      "Go to Circle Requests screen and approve or reject pending requests.",
    "How to view circle details?":
      "Use the search option in View Circle Details to see complete information.",
    "How to create a CGL?":
      "Navigate to CGL Management and click Create CGL. Fill mandatory fields and submit.",
    "How to approve a CGL request?":
      "Open CGL Requests screen and approve pending CGL creation requests.",
    "Where can I see CGL details?":
      "Search CGL from View CGL Details screen.",
    "How to create a branch?":
      "Go to Branch Management, click Create, enter branch details, and submit.",
    "How to approve branch requests?":
      "Navigate to Branch Requests and approve or reject pending items.",
    "How to view branch details?":
      "Use View Branch Details option to search and view branch information.",
  };

  const handleModuleSelect = (module) => {
    setSelectedModule(module);
    setQuestions(MODULE_QUESTIONS[module] || []);
    setStep("QUESTIONS");
  };

  const handleQuestionSelect = (q) => {
    setTyping(true);
    setAnswer("");

    setTimeout(() => {
      setTyping(false);
      setAnswer(MODULE_ANSWERS[q]);
      setStep("ANSWER");
    }, 1500);
  };

  const reset = () => {
    setStep("HOME");
    setSelectedModule(null);
    setQuestions([]);
    setAnswer("");
  };

  return (
    <Drawer anchor="right" open={open} onClose={onClose}>
      <Box width={420} height="100vh" display="flex" flexDirection="column">
        {/* Header */}
        <Box
          p={2}
          display="flex"
          alignItems="center"
          justifyContent="space-between"
          borderBottom="1px solid #eee"
        >
          <Stack direction="row" spacing={1} alignItems="center">
            <SmartToyIcon color="primary" />
            <Typography fontWeight={600}>FinCore Assistant</Typography>
          </Stack>
          <IconButton onClick={onClose}>
            <CloseIcon />
          </IconButton>
        </Box>

        {/* Content */}
        <Box p={2} flex={1} overflow="auto">
          {step === "HOME" && (
            <Stack spacing={2}>
              <Typography>Select an option to continue</Typography>
              <Button
                variant="contained"
                onClick={() => setStep("MODULES")}
              >
                Select Module
              </Button>
            </Stack>
          )}

          {step === "MODULES" && (
            <Stack spacing={1.5}>
              <Typography fontWeight={500}>
                Select a module
              </Typography>
              {modules.map((m) => (
                <Chip
                  key={m}
                  label={m}
                  clickable
                  onClick={() => handleModuleSelect(m)}
                  icon={<CheckCircleOutlineIcon />}
                />
              ))}
              <Divider />
              <Button size="small" onClick={reset}>
                Back
              </Button>
            </Stack>
          )}

          {step === "QUESTIONS" && (
            <Stack spacing={1.5}>
              <Typography fontWeight={500}>
                {selectedModule} Questions
              </Typography>
              {questions.map((q) => (
                <Chip
                  key={q}
                  label={q}
                  clickable
                  onClick={() => handleQuestionSelect(q)}
                />
              ))}
              <Divider />
              <Button size="small" onClick={() => setStep("MODULES")}>
                Change Module
              </Button>
            </Stack>
          )}

          {step === "ANSWER" && (
            <Stack spacing={2}>
              <Typography fontWeight={500}>Answer</Typography>

              {typing ? (
                <Stack direction="row" spacing={1} alignItems="center">
                  <CircularProgress size={16} />
                  <Typography variant="body2">
                    Assistant is typing...
                  </Typography>
                </Stack>
              ) : (
                <Typography variant="body2">{answer}</Typography>
              )}

              <Divider />
              <Button size="small" onClick={reset}>
                Start Again
              </Button>
            </Stack>
          )}
        </Box>
      </Box>
    </Drawer>
  );
}
