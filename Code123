
import React, { useEffect, useMemo, useState } from "react";
import {
  Box,
  Button,
  Dialog,
  DialogContent,
  DialogActions,
  MenuItem,
  Stack,
  TextField,
  Typography,
  Checkbox,
  FormControlLabel,
  Tooltip,
  IconButton,
  styled,
} from "@mui/material";
import {
  Add as AddIcon,
  Edit as EditIcon,
  Close as CloseIcon,
  Delete as DeleteIcon,
} from "@mui/icons-material";
import { DataGrid } from "@mui/x-data-grid";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import {
  CircleTab1Fab,
  CircleTab1Addicon,
  CircleTab1Container,
} from "./FileMasterStyle";

const TYPE_OPTIONS = [
  { value: "bancs24", label: "Bancs24" },
  { value: "glif", label: "GLIF" },
];

const FREQUENCY_MAP = [
  { label: "Daily", key: "D" },
  { label: "Monthly", key: "M" },
  { label: "Yearly", key: "Y" },
];

const EMPTY_FORM = {
  type: "",
  subType: "",
  filePattern: "",
  stream: "",
  includeFile: "",
  frequency: { D: false, M: false, Y: false },
};

const OverlayBox = styled(Box)(() => ({
  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => (
  <OverlayBox>
    <ErrorOutlineIcon fontSize="large" />
    <Typography variant="h5" fontSize="1.2rem">
      Data is not available
    </Typography>
  </OverlayBox>
);

export default function FileManagementTab() {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [rows, setRows] = useState([]);
  const [open, setOpen] = useState(false);
  const [editingId, setEditingId] = useState(null);
  const [loading, setLoading] = useState(true);
  const [formData, setFormData] = useState(EMPTY_FORM);
  const [originalData, setOriginalData] = useState(null);
  const [isDataSame, setIsDataSame] = useState(true);
  const [errors, setErrors] = useState({});

  /* ---------------- FETCH ---------------- */
  const fetchData = async () => {
    try {
      setLoading(true);
      const res = await callApi("/CM/common-master/files", null, "GET");
      setRows(res?.data || []);
    } catch {
      snackbar("Failed to load file configurations", "error");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  /* ---------------- VALIDATION ---------------- */
  const validateField = (name, value) => {
    switch (name) {
      case "type":
        if (!value) return "Type is required";
        break;

      case "subType":
        if (!value) return "Sub Type is required";
        break;

      case "filePattern":
        if (!value) return "File Pattern is required";
        if (!/^[A-Z0-9]+$/.test(value))
          return "Only capital letters and numbers allowed";
        break;

      case "stream":
        if (!value) return "Stream is required";
        break;

      case "includeFile":
        if (!value) return "Include is required";
        break;

      case "frequency":
        if (!Object.values(value).some(Boolean))
          return "At least one frequency is required";
        break;

      default:
        return "";
    }
    return "";
  };

  const isFormValid = useMemo(
    () =>
      !validateField("type", formData.type) &&
      !validateField("subType", formData.subType) &&
      !validateField("filePattern", formData.filePattern) &&
      !validateField("stream", formData.stream) &&
      !validateField("includeFile", formData.includeFile) &&
      !validateField("frequency", formData.frequency),
    [formData],
  );

  /* ---------------- EDIT CHANGE DETECTION ---------------- */
  useEffect(() => {
    if (editingId && originalData) {
      setIsDataSame(
        JSON.stringify(formData) === JSON.stringify(originalData),
      );
    }
  }, [formData, originalData, editingId]);

  /* ---------------- HANDLERS ---------------- */
  const handleChange = (e) => {
    let { name, value } = e.target;

    if (name === "filePattern") {
      value = value.toUpperCase();
      if (!/^[A-Z0-9]*$/.test(value)) {
        snackbar("Only letters and numbers allowed", "warning");
        return;
      }
    }

    setFormData((p) => ({ ...p, [name]: value }));
    setErrors((p) => ({ ...p, [name]: validateField(name, value) }));
  };

  const handleFrequencyChange = (key) => {
    setFormData((p) => ({
      ...p,
      frequency: { ...p.frequency, [key]: !p.frequency[key] },
    }));
  };

  const parseFrequency = (freq) => {
    const result = { D: false, M: false, Y: false };
    if (!freq) return result;
    freq
      .toUpperCase()
      .split(/[/,]/)
      .forEach((f) => (result[f] = true));
    return result;
  };

  const handleEdit = (row) => {
    const init = {
      type: row.type,
      subType: row.subType,
      filePattern: row.filePattern,
      stream: row.stream,
      includeFile: row.includeFile,
      frequency: parseFrequency(row.frequency),
    };
    setFormData(init);
    setOriginalData(init);
    setEditingId(row.fileId);
    setOpen(true);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (editingId && isDataSame) {
      snackbar("No changes detected", "warning");
      return;
    }

    if (!isFormValid) {
      snackbar("Please fix validation errors", "error");
      return;
    }

    if (!editingId) {
      const exists = rows.some(
        (r) =>
          r.type === formData.type &&
          r.subType === formData.subType &&
          r.filePattern === formData.filePattern &&
          r.stream === formData.stream &&
          r.includeFile === formData.includeFile &&
          r.frequency ===
            Object.keys(formData.frequency)
              .filter((k) => formData.frequency[k])
              .join("/"),
      );
      if (exists) {
        snackbar("File configuration already exists", "error");
        return;
      }
    }

    const payload = {
      requestType: "FILE_TYPE_MASTER",
      changeType: editingId ? "UPDATE" : "ADD",
      targetId: formData.filePattern,
      payload: {
        ...formData,
        frequency: Object.keys(formData.frequency)
          .filter((k) => formData.frequency[k])
          .join("/"),
      },
    };

    try {
      const res = await callApi("/CR/create-request", payload, "POST");
      snackbar(`Request submitted. ID: ${res?.data?.id}`, "success");
      setOpen(false);
      setFormData(EMPTY_FORM);
      setEditingId(null);
      fetchData();
    } catch {
      snackbar("Request failed", "error");
    }
  };

  /* ---------------- UI ---------------- */
  return (
    <CircleTab1Container>
      <DataGrid
        rows={rows}
        loading={loading}
        columns={[
          { field: "type", headerName: "File Type", flex: 1 },
          { field: "filePattern", headerName: "File Pattern", flex: 1 },
          { field: "stream", headerName: "Stream", flex: 1 },
          { field: "frequency", headerName: "Frequency", flex: 1 },
          { field: "includeFile", headerName: "Include", flex: 1 },
          {
            field: "actions",
            headerName: "Actions",
            renderCell: (p) => (
              <IconButton onClick={() => handleEdit(p.row)}>
                <EditIcon />
              </IconButton>
            ),
          },
        ]}
        getRowId={(r) => r.fileId}
        slots={{ noRowsOverlay: CustomNoRowsOverlay }}
      />

      <CircleTab1Fab onClick={() => setOpen(true)}>
        <CircleTab1Addicon />
        Create
      </CircleTab1Fab>

      <Dialog open={open} maxWidth="sm" fullWidth>
        <Box component="form" onSubmit={handleSubmit}>
          <DialogContent>
            <Stack spacing={2}>
              <TextField
                select
                label="Type"
                name="type"
                value={formData.type}
                onChange={handleChange}
                disabled={!!editingId}
              >
                {TYPE_OPTIONS.map((o) => (
                  <MenuItem key={o.value} value={o.value}>
                    {o.label}
                  </MenuItem>
                ))}
              </TextField>

              <TextField
                label="File Pattern"
                name="filePattern"
                value={formData.filePattern}
                onChange={handleChange}
                error={!!errors.filePattern}
                helperText={errors.filePattern}
              />

              <Box>
                <Typography>Frequency</Typography>
                {FREQUENCY_MAP.map((f) => (
                  <FormControlLabel
                    key={f.key}
                    control={
                      <Checkbox
                        checked={formData.frequency[f.key]}
                        onChange={() => handleFrequencyChange(f.key)}
                      />
                    }
                    label={f.label}
                  />
                ))}
                {errors.frequency && (
                  <Typography color="error">{errors.frequency}</Typography>
                )}
              </Box>

              <TextField
                select
                label="Include"
                name="includeFile"
                value={formData.includeFile}
                onChange={handleChange}
              >
                <MenuItem value="Y">Yes</MenuItem>
                <MenuItem value="N">No</MenuItem>
              </TextField>
            </Stack>
          </DialogContent>

          <DialogActions>
            <Button
              type="submit"
              variant="contained"
              startIcon={editingId ? <EditIcon /> : <AddIcon />}
              disabled={!isFormValid || (editingId && isDataSame)}
            >
              {editingId ? "Update" : "Add"}
            </Button>
          </DialogActions>
        </Box>
      </Dialog>
    </CircleTab1Container>
  );
}
