package com.fincore.enquiry_service.service.utils;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.time.format.DateTimeFormatter;
import java.util.List;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.ss.util.CellRangeAddress;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import com.fincore.enquiry_service.model.GlTransactions;

public class TransactionsExcelGenerator {

	private static final String SHEET_NAME = "Transactions";
	private static final String SHEET_TITLE = "GL Transactions";

	// private static final Header[] SUMMARY_HEADERS = {
	// new Header("Branch", Header.Type.NUMERIC, 0),
	// new Header("Currency", Header.Type.TEXT, 1),
	// new Header("CGL", Header.Type.NUMERIC, 2),
	// new Header("From Date", Header.Type.NUMERIC, 4),
	// new Header("To Date", Header.Type.NUMERIC, 5),
	// new Header("From Amount", Header.Type.NUMERIC, 6),
	// new Header("To Amount", Header.Type.NUMERIC, 7)
	// };

	private static final Header[] TRANSACTION_HEADERS = {
			new Header("Date", Header.Type.NUMERIC, 0),
			new Header("Batch ID", Header.Type.TEXT, 1),
			new Header("Journal Number", Header.Type.NUMERIC, 2),
			new Header("Debit Amount", Header.Type.NUMERIC, 3),
			new Header("Credit Amount", Header.Type.NUMERIC, 4),
			new Header("Narration", Header.Type.TEXT, 5),

			new Header("Transaction Type", Header.Type.NUMERIC, 6),
			new Header("Source Flag", Header.Type.TEXT, 7),
			new Header("Posted Date", Header.Type.TEXT, 8)

	};

	private static final int MAX_COLUMNS = 6;
	private static final int FREEZE_UPTO_ROW = 6;

	private String branch;
	private String currency;
	private String cgl;
	private String fromDate;
	private String toDate;
	private double openingBalance;
	private double closingBalance;
	private String openingDate;
	private String closingDate;
	private Double minAmount;
	private Double maxAmount;
	private List<GlTransactions> transactions;

	private final Workbook workbook = new XSSFWorkbook();
	private final Sheet transactionsSheet = workbook.createSheet(SHEET_NAME);

	private final Font headerFont = workbook.createFont();

	private final CellStyle textHeaderStyle = workbook.createCellStyle();
	private final CellStyle textBodyStyle = workbook.createCellStyle();
	private final CellStyle numericHeaderStyle = workbook.createCellStyle();
	private final CellStyle numericBodyStyle = workbook.createCellStyle();
	private final CellStyle amountStyle = workbook.createCellStyle();

	private final DataFormat format = workbook.createDataFormat();

	private int rowIndex = 0;

	private final DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");

	private void createHeaderCell(Row row, int column, String value) {

		Cell cell = row.createCell(column);

		cell.setCellValue(value);

		cell.setCellStyle(textHeaderStyle);
	}

	private TransactionsExcelGenerator(
			String branch,
			String currency,
			String cgl,
			String fromDate,
			String toDate,
			List<GlTransactions> transactions,
			double openingBalance,
			double closingBalance,
			String openingDate,
			String closingDate,
			Double minAmount,
			Double maxAmount) {

		this.branch = branch;
		this.currency = currency;
		this.cgl = cgl;
		this.fromDate = fromDate;
		this.toDate = toDate;
		this.transactions = transactions;
		this.openingBalance = openingBalance;
		this.closingBalance = closingBalance;
		this.openingDate = openingDate;
		this.closingDate = closingDate;
		this.minAmount = minAmount;
		this.maxAmount = maxAmount;

		headerFont.setBold(true);

		textHeaderStyle.setFont(headerFont);
		numericHeaderStyle.setFont(headerFont);
		numericHeaderStyle.setAlignment(HorizontalAlignment.RIGHT);

		numericBodyStyle.setAlignment(HorizontalAlignment.RIGHT);
		amountStyle.setAlignment(HorizontalAlignment.RIGHT);
		amountStyle.setDataFormat(format.getFormat("0.0000"));

		transactionsSheet.createFreezePane(0, FREEZE_UPTO_ROW);
	}

	private void addTitle() {
		Row row = transactionsSheet.createRow(rowIndex++);
		Cell cell = row.createCell(0);
		cell.setCellValue(SHEET_TITLE);

		CellStyle style = workbook.createCellStyle();
		Font font = workbook.createFont();
		font.setBold(true);
		font.setFontHeightInPoints((short) 14);

		style.setFont(font);
		style.setAlignment(HorizontalAlignment.CENTER);

		cell.setCellStyle(style);

		transactionsSheet.addMergedRegion(new CellRangeAddress(0, 0, 0, MAX_COLUMNS));

		rowIndex++;
	}

	private void addSummaryHeader() {

		Row row = transactionsSheet.createRow(rowIndex++);

		int col = 0;

		createHeaderCell(row, col++, "Branch");
		createHeaderCell(row, col++, "Currency");
		createHeaderCell(row, col++, "CGL");
		createHeaderCell(row, col++, "From Date");
		createHeaderCell(row, col++, "To Date");

		if (minAmount != null) {
			createHeaderCell(row, col++, "From Amount");
		}

		if (maxAmount != null) {
			createHeaderCell(row, col++, "To Amount");
		}
	}

	private void addSummaryValues() {

		Row row = transactionsSheet.createRow(rowIndex++);

		int col = 0;

		row.createCell(col++).setCellValue(branch);
		row.createCell(col++).setCellValue(currency);
		row.createCell(col++).setCellValue(cgl);
		row.createCell(col++).setCellValue(fromDate);
		row.createCell(col++).setCellValue(toDate);

		if (minAmount != null) {

			Cell cell = row.createCell(col++);
			cell.setCellValue(minAmount);
			cell.setCellStyle(amountStyle);
		}

		if (maxAmount != null) {

			Cell cell = row.createCell(col++);
			cell.setCellValue(maxAmount);
			cell.setCellStyle(amountStyle);
		}

		rowIndex++;
	}

	private void addOpeningClosingSection() {

		Row r1 = transactionsSheet.createRow(rowIndex++);
		r1.createCell(0).setCellValue("Opening Date");
		r1.createCell(1).setCellValue(openingDate);
		r1.createCell(2).setCellValue("Opening Balance");
		Cell openCell = r1.createCell(3);
		openCell.setCellValue(openingBalance);
		openCell.setCellStyle(amountStyle);

		Row r2 = transactionsSheet.createRow(rowIndex++);
		r2.createCell(0).setCellValue("Closing Date");
		r2.createCell(1).setCellValue(closingDate);
		r2.createCell(2).setCellValue("Closing Balance");
		Cell closeCell = r2.createCell(3);
		closeCell.setCellValue(closingBalance);
		closeCell.setCellStyle(amountStyle);

		rowIndex++;
	}

	private void addTransactionHeader() {
		Row row = transactionsSheet.createRow(rowIndex++);

		for (int i = 0; i < TRANSACTION_HEADERS.length; i++) {
			Header h = TRANSACTION_HEADERS[i];
			Cell cell = row.createCell(i);
			cell.setCellValue(h.title);
			cell.setCellStyle(h.type == Header.Type.NUMERIC ? numericHeaderStyle : textHeaderStyle);
		}
	}

	private void addTransactionRow(GlTransactions txn) {

		Row row = transactionsSheet.createRow(rowIndex++);

		row.createCell(0).setCellValue(formatter.format(txn.getTransactionDate()));
		row.createCell(1).setCellValue(txn.getBatchId());
		row.createCell(2).setCellValue(txn.getJournalId());

		Cell debitCell = row.createCell(3);
		debitCell.setCellValue(
				txn.getDebitAmount() != null ? Math.abs(txn.getDebitAmount()) : 0);
		debitCell.setCellStyle(amountStyle);

		Cell creditCell = row.createCell(4);
		creditCell.setCellValue(
				txn.getCreditAmount() != null ? Math.abs(txn.getCreditAmount()) : 0);
		creditCell.setCellStyle(amountStyle);
		row.createCell(5).setCellValue(txn.getNarration());

		row.createCell(6).setCellValue(
				txn.getTransactionCount() != null ? txn.getTransactionCount() : 0);

		row.createCell(7).setCellValue(SourceFlagUtil.getSourceFlagDescription(txn.getSourceFlag()));
		row.createCell(8).setCellValue(
				txn.getPostDate() != null
						? txn.getPostDate().toLocalDateTime().format(
								DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm:ss"))
						: "");

	}

	private void addTransactions() {
		for (GlTransactions txn : transactions) {
			addTransactionRow(txn);
		}

		for (int i = 0; i < TRANSACTION_HEADERS.length; i++) {
			transactionsSheet.autoSizeColumn(i);
		}
	}

	public byte[] getByteArray() throws IOException {

		addTitle();
		addSummaryHeader();
		addSummaryValues();
		addOpeningClosingSection();
		addTransactionHeader();
		addTransactions();

		try (ByteArrayOutputStream bos = new ByteArrayOutputStream()) {
			workbook.write(bos);
			return bos.toByteArray();
		} finally {
			workbook.close();
		}
	}

	public static byte[] getFileContents(
			String branch,
			String currency,
			String cgl,
			String fromDate,
			String toDate,
			List<GlTransactions> transactions,
			double openingBalance,
			double closingBalance,
			String openingDate,
			String closingDate,
			Double minAmount,
			Double maxAmount) throws IOException {

		return new TransactionsExcelGenerator(
				branch,
				currency,
				cgl,
				fromDate,
				toDate,
				transactions,
				openingBalance,
				closingBalance,
				openingDate,
				closingDate,
				minAmount,
				maxAmount).getByteArray();
	}

	private record Header(String title, Type type, int columnIndex) {
		enum Type {
			TEXT, NUMERIC
		}
	}
}
