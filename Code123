import {
  Box,
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  IconButton,
  Dialog,
  DialogTitle,
  DialogContent,
  Button
} from "@mui/material";

import VisibilityIcon from "@mui/icons-material/Visibility";
import { useEffect, useState } from "react";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../hooks/useCustomSnackbar";

export default function DataParametersRequestTab() {

  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [requests, setRequests] = useState([]);
  const [open, setOpen] = useState(false);
  const [selected, setSelected] = useState(null);

  /* ---------------- FETCH REQUESTS ---------------- */

  const fetchRequests = async () => {
    try {
      const res = await callApi(
        "api/common-request?requestType=MAIN_DATA_PARAMETERS",
        {},
        "GET"
      );

      if (!res?.data?.success) {
        snackbar("Failed to load requests", "error");
        return;
      }

      setRequests(res.data.data || []);

    } catch {
      snackbar("Failed to load requests", "error");
    }
  };

  useEffect(() => {
    fetchRequests();
  }, []);

  return (
    <Box mt={2}>

      {/* -------- MAIN TABLE -------- */}

      <Table>
        <TableHead>
          <TableRow>
            <TableCell>File Type</TableCell>
            <TableCell align="right">Actions</TableCell>
          </TableRow>
        </TableHead>

        <TableBody>
          {requests.map((req) => (
            <TableRow key={req.id}>
              <TableCell>
                {req.payload?.fileType}
              </TableCell>

              <TableCell align="right">
                <IconButton
                  onClick={() => {
                    setSelected(req);
                    setOpen(true);
                  }}
                >
                  <VisibilityIcon />
                </IconButton>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>

      {/* -------- VIEW DIALOG -------- */}

      <Dialog open={open} fullWidth maxWidth="lg">
        <DialogTitle>Request Details</DialogTitle>

        <DialogContent>

          {selected && (
            <Box>

              {/* Request Info */}
              <Box mb={2}>
                <p><b>File Type:</b> {selected.payload?.fileType}</p>
                <p><b>Creator ID:</b> {selected.creatorId}</p>
                <p><b>Change Type:</b> {selected.changeType}</p>
                <p><b>Request Status:</b> {selected.reqStatus}</p>
                <p><b>Requested Date:</b> {selected.reqDate}</p>
              </Box>

              {/* Data Table */}
              <Table size="small">
                <TableHead>
                  <TableRow>
                    <TableCell>Column Id</TableCell>
                    <TableCell>Column Name</TableCell>
                    <TableCell>Start</TableCell>
                    <TableCell>End</TableCell>
                    <TableCell>Included</TableCell>
                    <TableCell>Data Type</TableCell>
                    <TableCell>Decimal</TableCell>
                  </TableRow>
                </TableHead>

                <TableBody>
                  {selected.payload?.rows?.map((row, index) => (
                    <TableRow key={index}>
                      <TableCell>{row.columnId || "-"}</TableCell>
                      <TableCell>{row.columnName}</TableCell>
                      <TableCell>{row.startValue}</TableCell>
                      <TableCell>{row.endValue}</TableCell>
                      <TableCell>
                        {row.toBeIncluded === true ||
                         row.toBeIncluded === "true" ||
                         row.toBeIncluded === "YES"
                          ? "YES"
                          : "NO"}
                      </TableCell>
                      <TableCell>{row.dataType}</TableCell>
                      <TableCell>{row.decimalCount}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>

            </Box>
          )}

        </DialogContent>

        <Box textAlign="right" p={2}>
          <Button onClick={() => setOpen(false)}>
            Close
          </Button>
        </Box>

      </Dialog>

    </Box>
  );
}
