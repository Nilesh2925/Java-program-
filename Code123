package com.tcs.userservice.controller;

import com.fincore.commonutilities.jwt.JwtUtil;
import com.tcs.userservice.dto.UserRequestCreateDto;
import com.tcs.userservice.dto.UserRequestDto;
import com.tcs.userservice.service.UserRequestService;
import com.tcs.userservice.utility.RequestUtility;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import java.util.Map;

/**
 * REST controller for managing user lifecycle including creation, approval, and permission assignment.
 * <p>
 * Handles all user-related operations such as creating new users, viewing pending user creation requests,
 * approving or rejecting requests. This controller serves as the entry point for user management workflows.
 *
 *  @author SHUBHANKAR DAS [Emp ID: V1018405]
 *  <a href="mailto:shubhankar.das.cbstcs@sbi.co.in">shubhankar.das.cbstcs@sbi.co.in</a>
 *  @version 1.0.1
 *  @since 2025-04-01
 */
@Slf4j
@RestController
@RequestMapping("/api/user")
@RequiredArgsConstructor
public class UserRequestController {

    private final UserRequestService userRequestService;
    private final JwtUtil jwtUtil;

    @PostMapping("/create-request")
    public ResponseEntity createNewRequest(@Valid @RequestBody UserRequestCreateDto request,
                                              @RequestHeader("Authorization") String token) {
        log.info("Received request to create user : {}", request);
        String userId = jwtUtil.getUserIdFromToken(token);
        return userRequestService.createNewRequest(request, userId);
    }

    @GetMapping("/pending-user-requests")
    public ResponseEntity getPendingRequests(@RequestParam Map<String, Object> params,
                                             @RequestHeader("Authorization") String token) {
        String userId = jwtUtil.getUserIdFromToken(token);
        log.info("Received request to fetch all user creation pending requests for user id : {}", userId);
        return userRequestService.getPendingRequests(params, userId);
    }

    @PostMapping("/accept-request")
    public ResponseEntity acceptRequest(HttpServletRequest request,
                                        @RequestBody UserRequestDto userRequest,
                                        @RequestHeader("Authorization") String token) {
        String clientIp = RequestUtility.getClientIp(request);
        String userId = jwtUtil.getUserIdFromToken(token);
        userRequest.setApproverUserId(userId);
        log.info("Received request to execute user request : {}", userRequest);
        return userRequestService.acceptOrRejectUserRequest(userRequest, clientIp, userId);
    }

    @GetMapping("/user-details")
    public ResponseEntity getUserDetails(@RequestParam Map<String, String> request) {
        String userId = request.get("id");
        String role = request.get("roleId");
        log.info("Received request to fetch all user details for the user : {} and role {}", userId, role);
        return userRequestService.getUserDetails(request);
    }

    @GetMapping("/my-requests")
    public ResponseEntity getMyRequests(@RequestHeader("Authorization") String token, @RequestParam Map<String, String> params) {
        String userId = jwtUtil.getUserIdFromToken(token);
        log.info("Received request to fetch my requests for user : {}", userId);
        return userRequestService.getMyRequests(params, userId);
    }

    @PostMapping("/cancel-request")
    public ResponseEntity cancelRequest(@RequestHeader("Authorization") String token, @RequestBody Map<String, Object> request) {
        log.info("Received request to cancel request with request id : {}", request.get("requestId"));
        return userRequestService.cancelRequest(request, jwtUtil.getUserIdFromToken(token));
    }

    @GetMapping("/validate/userid")
    public ResponseEntity validateUserId(@RequestParam("userId") String userId){
        log.info("Received request to validate user Id : {}", userId);
        return userRequestService.validateUserId(userId);
    }
}


