	@Override
	public PaginatedResponseDTO<GetResponseDTO> getTransactionsData(GetPayloadDTO dto) {

		String branch = dto.getBranch().split("-")[0];
		String currency = dto.getCurrency();
		String cgl = dto.getCgl();
		String fromDate = dto.getFromDate();
		String toDate = dto.getToDate();

		DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");

		Double minAmount = dto.getMinAmount();
		Double maxAmount = dto.getMaxAmount();
		List<String> sourceFlag = dto.getSourceFlags();
		int applySourceFlag = 1;

		LocalDate formattedFromDate = LocalDate.parse(fromDate, formatter);
		LocalDate formattedToDate = LocalDate.parse(toDate, formatter);

		LocalDate fromMinusOneDay = formattedFromDate.minusDays(1);

		GLBalance openingGLBalance = glBalanceRepository
				.getGlBalanceData(fromMinusOneDay.format(formatter), branch, currency, cgl);

		GLBalance closingGLBalance = glBalanceRepository
				.getGlBalanceData(formattedToDate.format(formatter), branch, currency, cgl);

		PaginatedResponseDTO<GetResponseDTO> response = new PaginatedResponseDTO<>();

		if (openingGLBalance == null || closingGLBalance == null) {
			response.setData(Collections.emptyList());
			return response;
		}

		if (sourceFlag == null || sourceFlag.isEmpty() || sourceFlag.contains("ALL")) {
			applySourceFlag = 0;
			sourceFlag = List.of("NA");
		}

		if (minAmount != null && maxAmount != null && minAmount > maxAmount) {
			throw new IllegalArgumentException("minAmount cannot be greater than maxAmount");
		}

		int page = (dto.getPage() == null || dto.getPage() < 0) ? 0 : dto.getPage();
		int size = (dto.getSize() == null || dto.getSize() <= 0) ? 10 : dto.getSize();

		// Sort sort = Sort.by("TRANSACTION_DATE");
		// Pageable pageable = PageRequest.of(page, size, sort);
		String sortBy = dto.getSortBy() != null
				? dto.getSortBy()
				: "TRANSACTION_DATE";

		String sortIn = dto.getSortIn() != null
				? dto.getSortIn()
				: "ASC";

		Sort.Direction direction = sortIn.equalsIgnoreCase("DESC")
				? Sort.Direction.DESC
				: Sort.Direction.ASC;

		Sort sort = Sort.by(direction, sortBy)
				.and(Sort.by("TRANSACTION_ID"));

		Pageable pageable = PageRequest.of(page, size, sort);

		Page<GlTransactions> pageResult = glTransactionsRepository.getData(
				branch,
				currency,
				cgl,
				fromDate,
				toDate,
				minAmount,
				maxAmount,
				sourceFlag,
				applySourceFlag,
				pageable);

		List<GetResponseDTO> responseList = new ArrayList<>();

		for (GlTransactions txn : pageResult.getContent()) {
			responseList.add(mapToResponseDTO(txn, formatter));
		}

		response.setCurrentPage(page);
		response.setTotalPages(pageResult.getTotalPages());
		response.setPageSize(size);
		response.setTotalElements(pageResult.getTotalElements());
		response.setData(responseList);

		Map<String, Object> extra = new HashMap<>();
		extra.put("openingBalance", openingGLBalance.getBalance());
		extra.put("closingBalance", closingGLBalance.getBalance());
		extra.put("openingDate", formatter.format(formattedFromDate));
		extra.put("closingDate", formatter.format(formattedToDate));

		response.setExtraData(extra);

		return response;
	}

	@Override
	public byte[] getTransactionsFile(GetPayloadDTO dto, String userId) throws IOException {

		log.info("Processing export for user: {}", userId);
		log.info("GetPayloadDTO>>>>{}", dto);

		String branch = dto.getBranch().split("-")[0];
		String currency = dto.getCurrency();
		String cgl = dto.getCgl().split(" -")[0];
		String fromDate = dto.getFromDate();
		String toDate = dto.getToDate();
		Double minAmount = dto.getMinAmount();
		Double maxAmount = dto.getMaxAmount();
		List<String> sourceFlag = dto.getSourceFlags();
		int applySourceFlag = 1;

		DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");

		LocalDate formattedFromDate = LocalDate.parse(fromDate, formatter);
		LocalDate fromMinusOneDay = formattedFromDate.minusDays(1);
		LocalDate formattedToDate = LocalDate.parse(toDate, formatter);

		log.info("fromMinusDay " + fromMinusOneDay.format(formatter));

		GLBalance openingGLBalance = glBalanceRepository
				.getGlBalanceData(fromMinusOneDay.format(formatter), branch, currency, cgl);

		GLBalance closingGLBalance = glBalanceRepository
				.getGlBalanceData(formattedToDate.format(formatter), branch, currency, cgl);

		log.info("OpeningBalance " + openingGLBalance);

		if (openingGLBalance == null) {
			throw new IllegalStateException("Opening Balance missing for date: " + fromMinusOneDay);
		}
		if (sourceFlag == null || sourceFlag.isEmpty() || sourceFlag.contains("ALL")) {
			applySourceFlag = 0;
			sourceFlag = List.of("NA");
		}

		int page = 0;
		int size = 500;

		// Sort sort = Sort.by("TRANSACTION_DATE");
		String sortBy = dto.getSortBy() != null
				? dto.getSortBy()
				: "TRANSACTION_DATE";

		String sortIn = dto.getSortIn() != null
				? dto.getSortIn()
				: "ASC";

		Sort.Direction direction = sortIn.equalsIgnoreCase("DESC")
				? Sort.Direction.DESC
				: Sort.Direction.ASC;

		Sort sort = Sort.by(direction, sortBy)
				.and(Sort.by("TRANSACTION_ID"));

		List<GlTransactions> allTransactions = new ArrayList<>();

		Page<GlTransactions> pageResult;

		do {
			Pageable pageable = PageRequest.of(page, size, sort);

			pageResult = glTransactionsRepository.getData(
					branch,
					currency,
					cgl,
					fromDate,
					toDate,
					minAmount,
					maxAmount,
					sourceFlag,
					applySourceFlag,
					pageable);

			allTransactions.addAll(pageResult.getContent());

			page++;

		} while (pageResult.hasNext());

		SearchCriteriaDTO searchDto = new SearchCriteriaDTO();

		searchDto.setBranch(dto.getBranch());
		searchDto.setCgl(dto.getCgl());
		searchDto.setCurrency(dto.getCurrency());
		searchDto.setFromDate(dto.getFromDate());
		searchDto.setToDate(dto.getToDate());

		if (dto.getMinAmount() != null) {
			searchDto.setMinAmount(dto.getMinAmount());
		}

		if (dto.getMaxAmount() != null) {
			searchDto.setMaxAmount(dto.getMaxAmount());
		}

		if (dto.getSourceFlags() == null) {
			searchDto.setSourceFlags(List.of("ALL"));
		} else {
			searchDto.setSourceFlags(dto.getSourceFlags());
		}
		String fileName = "Transaction_Enquiry.xlsx";

		// -------- GENERATE FILE --------
		
		byte[] fileBytes = TransactionsExcelGenerator.getFileContents(
				branch,
				currency,
				cgl,
				fromDate,
				toDate,
				allTransactions,
				openingGLBalance.getBalance(),
				closingGLBalance.getBalance(),
				formatter.format(
						formattedFromDate),
				formatter.format(new java.sql.Date(closingGLBalance.getDate().getTime()).toLocalDate()), minAmount,
				maxAmount);

		sendToMyDownloads(searchDto, fileBytes, userId, fileName);

		return fileBytes;
	}

	@Override
	public PaginatedResponseDTO<BalanceResponseDTO> getBalanceDetails(BalanceRequestDTO request) {
		if (request.getEndDate().before(request.getStartDate())) {
			log.error("End date must be after start date.");
			throw new IllegalArgumentException("End date must be after start date");
		}

		// 1. Force Start Date to 00:00:00 IST
		Date adjustedStartDate = convertToStartOfDay(request.getStartDate());
		// 2. Force End Date to 23:59:59 IST
		Date adjustedEndDate = convertToEndOfDay(request.getEndDate());

		int page = (request.getPage() != null && request.getPage() >= 0) ? request.getPage() : 0;
		int size = (request.getSize() != null && request.getSize() >= 0) ? request.getSize() : 10;

		String sortIn = (request.getSortIn() != null && !request.getSortIn().isBlank())
				? request.getSortIn().toUpperCase()
				: "ASC";

		Sort sort = sortIn.equals("DESC") ? Sort.by("date").descending() : Sort.by("date").ascending();
		PageRequest pageRequest = PageRequest.of(page, size, sort);

		log.info("Adjusted Start Date : {}", adjustedStartDate);
		log.info("Adjusted End Date : {}", adjustedEndDate);

		Page<GLBalance> records = glBalanceRepository.findByBranchAndCglAndCurrencyAndDateBetween(
				request.getBranch(), request.getCgl(), request.getCurrency(),
				adjustedStartDate, adjustedEndDate,
				pageRequest);

		if (records.isEmpty()) {
			log.warn("No records found for the given filters.");
			throw new NoDataFoundException("No records found for given filters");
		}

		List<BalanceResponseDTO> list = records.stream()
				.map(r -> new BalanceResponseDTO(
						r.getId(), r.getDate(), r.getBranch(), r.getCgl(), r.getCurrency(), r.getBalance(),
						r.getBalance() < 0 ? "DR" : "CR"))
				.toList();

		String actualSort = records.getSort().stream().findFirst().map(order -> order.getDirection().name())
				.orElse("UNSORTED");

		return new PaginatedResponseDTO<>(
				records.getNumber(), records.getTotalPages(), records.getSize(), records.getTotalElements(), actualSort,
				list, null);
	}

	@Override
	public byte[] exportBalanceToExcel(BalanceRequestDTO request, String userId) {
		// 1. VALIDATION
		if (request.getEndDate().before(request.getStartDate())) {
			throw new IllegalArgumentException("End date must be after start date");
		}

		Date adjustedStartDate = convertToStartOfDay(request.getStartDate());
		Date adjustedEndDate = convertToEndOfDay(request.getEndDate());

		try (Workbook workbook = new XSSFWorkbook();
				ByteArrayOutputStream out = new ByteArrayOutputStream()) {

			Sheet sheet = workbook.createSheet("Balance Enquiry");

			// 2. STYLES INITIALIZATION
			CellStyle headerStyle = workbook.createCellStyle();
			Font headerFont = workbook.createFont();
			headerFont.setBold(true);
			headerStyle.setFont(headerFont);

			CellStyle centerStyle = workbook.createCellStyle();
			centerStyle.setAlignment(HorizontalAlignment.CENTER);

			CellStyle dateStyle = workbook.createCellStyle();
			CreationHelper creationHelper = workbook.getCreationHelper();
			dateStyle.setDataFormat(creationHelper.createDataFormat().getFormat("dd-MM-yyyy"));

			CellStyle balanceStyle = workbook.createCellStyle();
			balanceStyle.setDataFormat(creationHelper.createDataFormat().getFormat("#,##0.00"));

			CellStyle titleStyle = workbook.createCellStyle();
			Font titleFont = workbook.createFont();
			titleFont.setBold(true);
			titleFont.setFontHeightInPoints((short) 14);
			titleStyle.setFont(titleFont);
			titleStyle.setAlignment(HorizontalAlignment.CENTER);

			// 3. HEADER SECTION (TITLE & SUMMARY)
			Row titleRow = sheet.createRow(0);
			Cell titleCell = titleRow.createCell(0);
			titleCell.setCellValue("GL Balance Enquiry");
			titleCell.setCellStyle(titleStyle);
			sheet.addMergedRegion(new CellRangeAddress(0, 0, 0, 6));

			// Summary Table
			Row summaryHeader = sheet.createRow(2);
			String[] summaryHeaders = { "Branch", "Currency", "CGL", "From Date", "To Date" };
			for (int i = 0; i < summaryHeaders.length; i++) {
				Cell cell = summaryHeader.createCell(i);
				cell.setCellValue(summaryHeaders[i]);
				cell.setCellStyle(headerStyle);
			}

			Row summaryRow = sheet.createRow(3);
			summaryRow.createCell(0).setCellValue(request.getBranch());
			summaryRow.createCell(1).setCellValue(request.getCurrency());
			summaryRow.createCell(2).setCellValue(request.getCgl());

			Cell sDate = summaryRow.createCell(3);
			sDate.setCellValue(request.getStartDate());
			sDate.setCellStyle(dateStyle);

			Cell eDate = summaryRow.createCell(4);
			eDate.setCellValue(request.getEndDate());
			eDate.setCellStyle(dateStyle);

			// 4. MAIN DATA TABLE HEADER
			String[] columns = { "ID", "Date", "Branch", "CGL", "Currency", "Balance", "DR/CR" };
			Row headerRow = sheet.createRow(5);
			for (int i = 0; i < columns.length; i++) {
				Cell cell = headerRow.createCell(i);
				cell.setCellValue(columns[i]);
				cell.setCellStyle(headerStyle);
			}

			// 5. DATA POPULATION (PAGINATED)
			int rowIdx = 6;
			int page = 0;
			Page<GLBalance> recordsPage;

			do {
				Pageable pageable = PageRequest.of(page++, EXPORT_CHUNK_SIZE, Sort.by("date").ascending());
				recordsPage = glBalanceRepository.findByBranchAndCglAndCurrencyAndDateBetween(
						request.getBranch(), request.getCgl(), request.getCurrency(),
						adjustedStartDate, adjustedEndDate, pageable);

				if (recordsPage.isEmpty() && page == 1)
					break;

				for (GLBalance r : recordsPage.getContent()) {
					Row row = sheet.createRow(rowIdx++);
					row.createCell(0).setCellValue(r.getId() != null ? r.getId() : 0);

					Cell dCell = row.createCell(1);
					if (r.getDate() != null) {
						dCell.setCellValue(r.getDate());
						dCell.setCellStyle(dateStyle);
					}

					row.createCell(2).setCellValue(r.getBranch() != null ? r.getBranch() : "");
					row.createCell(3).setCellValue(r.getCgl() != null ? r.getCgl() : "");
					row.createCell(4).setCellValue(r.getCurrency() != null ? r.getCurrency() : "");

					double balance = r.getBalance();

					Cell bCell = row.createCell(5);
					bCell.setCellValue(Math.abs(balance));
					bCell.setCellStyle(balanceStyle);
					Cell drCrCell = row.createCell(6);
					drCrCell.setCellValue(balance < 0 ? "DR" : "CR");
					drCrCell.setCellStyle(centerStyle);

				}
			} while (!recordsPage.isLast());

			// 6. FINALIZATION & DOWNLOAD SERVICE
			for (int i = 0; i < columns.length; i++) {
				sheet.autoSizeColumn(i);
			}

			workbook.write(out);
			byte[] fileBytes = out.toByteArray();

			// Map Search Criteria for MyDownloads
			SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
			SearchCriteriaDTO searchDto = new SearchCriteriaDTO();
			searchDto.setBranch(request.getBranch());
			searchDto.setCgl(request.getCgl());
			searchDto.setCurrency(request.getCurrency());
			searchDto.setFromDate(sdf.format(request.getStartDate()));
			searchDto.setToDate(sdf.format(request.getEndDate()));

			sendToMyDownloads(searchDto, fileBytes, userId, "Balance_Enquiry.xlsx");

			return fileBytes;

		} catch (IOException e) {
			throw new RuntimeException("Failed to generate Excel file", e);
		}
	}

	@Override
	public PaginatedResponseDTO<GlTransactionResponseDTO> getGlTransactionsReport(
			String startDate, String endDate, String circle, String branch, String cgl, Integer page, Integer size,
			String currency) {

		int pageNo = (page != null && page >= 0) ? page : 0;
		int pageSize = (size != null && size > 0) ? size : 10;
		Pageable pageable = PageRequest.of(pageNo, pageSize);

		Page<GlTransactionProjection> pageResult = glTransactionsRepository.findGlTransactions(
				startDate, endDate, currency, circle, branch, cgl, pageable);

		List<GlTransactionResponseDTO> list = pageResult.getContent().stream()
				.map(this::toGlTransactionDto)
				.toList();

		if (list.isEmpty()) {
			log.warn("No transactions found for the given criteria.");
			throw new NoDataFoundException("No records found for the given criteria");
		}

		return new PaginatedResponseDTO<>(
				pageResult.getNumber(),
				pageResult.getTotalPages(),
				pageResult.getSize(),
				pageResult.getTotalElements(),
				null,
				list, null);
	}

	private GlTransactionResponseDTO toGlTransactionDto(GlTransactionProjection p) {
		return new GlTransactionResponseDTO(
				p.getCIRCLE_CODE(),
				p.getCIRCLE_NAME(),
				p.getBRANCH_NAME(),
				p.getBRANCH_CODE(),
				p.getCGL(),
				p.getCGL_DESCRIPTION(),
				p.getNARRATION(),
				p.getTRANSACTION_DATE(),
				p.getCURRENCY(),
				p.getTOTAL_DEBIT(),
				p.getTOTAL_CREDIT());
	}

	@Override
	public PaginatedResponseDTO<GLBalanceResponseDTO> getGlBalanceReport(
			String startDate, String endDate, String circle, String branch, String cgl, Integer page, Integer size,
			String currency) {

		Pageable pageable = PageRequest.of(page != null ? page : 0, size != null ? size : 10);

		Page<GLBalanceProjection> pageResult = glBalanceRepository.findGlBalances(
				startDate, endDate, currency, circle, branch, cgl, pageable);

		List<GLBalanceResponseDTO> list = pageResult.getContent().stream()
				.map(this::toGlBalanceDto)
				.toList();

		return new PaginatedResponseDTO<>(
				pageResult.getNumber(),
				pageResult.getTotalPages(),
				pageResult.getSize(),
				pageResult.getTotalElements(),
				null,
				list, null);
	}

