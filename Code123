//user approval
import React, { useEffect, useState, useCallback } from "react";
import { Box, Card, Divider } from "@mui/material";
import { useSelector } from "react-redux";

import useApi from "../../../hooks/useApi";
import ApprovalTable from "../components/ApprovalTable";
import ApproveRejectDialog from "../components/ApproveRejectDialog";
import UserRequestView from "../components/UserRequestView";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import RequestAnalytics from "../../common/RequestAnalytics";

const LIST_API = "/UM/user/pending-user-requests";
const ACT_API = "/UM/user/accept-request";
const REQ_API = "/UM/user/my-requests";

/* ----------------------------- small utilities ----------------------------- */

/** Safely stringify-like: always returns a string */
const customStringify = (v) => (v ?? "").toString();

/** Convert raw server rows to flat, grid-friendly rows */
function normalize(items = []) {
  return items.map((u, idx) => {
    const payload = u?.requestPayload ? JSON.parse(u?.requestPayload) : {};
    const USERID = payload?.userId ?? u?.targetUserId ?? u?.userId ?? "";

    const first = customStringify(payload?.firstName).trim();
    const middle = customStringify(payload?.middleName).trim();
    const last = customStringify(payload?.lastName).trim();
    const name = [first, middle, last].filter(Boolean).join(" ");

    return {
      id: u?.requestId ?? String(idx + 1),
      REQUEST_ID: u?.requestId ?? `${USERID}-${idx + 1}`,
      REQUEST_TYPE: u?.requestType ?? "CREATE",
      REQUESTED_AT: u?.requestDate ?? "",
      STATUS: u?.requestStatus ?? "PENDING",
      REQUESTOR_USERID: u?.requestorUserId ?? "",
      TARGET_USERID: u?.targetUserId ?? "",
      USERID: USERID,
      FIRST_NAME: first,
      MIDDLE_NAME: middle,
      LAST_NAME: last,
      EMAIL: payload?.email ?? "",
      PHONE_NUMBER: payload?.phoneNumber ?? "",
      ROLE_ID: payload?.roleId ?? "",
      ROLE_NAME: customStringify(payload?.roleName).trim(),
      BRANCH: payload?.branch ?? "",
      __name: name || USERID || "(unknown)",
      _raw: { ...u, ...payload },
    };
  });
}

/* --------------------------------- component -------------------------------- */

export default function UserApprovals() {
  const { callApi, loading } = useApi();
  const user = useSelector((state) => state.auth.user);

  const [rows, setRows] = useState([]);
  const [actOpen, setActOpen] = useState(false);
  const [actType, setActType] = useState("APPROVE"); // APPROVE | REJECT
  const [actTarget, setActTarget] = useState(null);
  const [AnalysisData, setAnalysisData] = useState(null);
  const [detailsOpen, setDetailsOpen] = useState(false);
  const [detailsRow, setDetailsRow] = useState(null);
  const showSnackBar = useCustomSnackbar();

  const makePayload = useCallback(
    () => ({ userId: user?.userId }),
    [user?.userId],
  );

  const fetchList = useCallback(
    async (status) => {
      const endpoint = status === "PENDING" ? LIST_API : REQ_API;

      try {
        const data = await callApi(endpoint, makePayload(), "GET");

        const list =
          data?.result?.pendingRequests ??
          data?.result?.requests ??
          data?.result?.users ??
          [];

        setRows(normalize(list));

        const processedResult = data?.result?.pendingRequests?.map((row) => {
          const status =
            row.requestType === "CREATE"
              ? "ADD"
              : row.requestType === "MODIFY"
                ? "UPDATE"
                : row.requestType;
          return {
            ...row,
            changeType: status,
            reqStatus: row.requestStatus,
            reqDate: row.requestDate,
          };
        });
        setAnalysisData(processedResult);
      } catch (e) {
        console.error(e);
        setRows([]);
      }
    },
    [callApi, makePayload],
  );

  const openApprove = useCallback((row) => {
    setActType("APPROVE");
    setActTarget(row);
    setActOpen(true);
  }, []);

  const openReject = useCallback((row) => {
    setActType("REJECT");
    setActTarget(row);
    setActOpen(true);
  }, []);

  const openDetails = useCallback((row) => {
    setDetailsRow(row);
    setDetailsOpen(true);
  }, []);

  useEffect(() => {
    fetchList("PENDING");
  }, [fetchList]);

  const handleConfirm = async (reason) => {
    setActOpen(false);
    setActTarget(null);
    try {
      const response = await callApi(
        ACT_API,
        {
          requestId: actTarget.REQUEST_ID,
          action: actType,
          reason: reason || "No Remarks",
        },
        "POST",
      );
      if (response?.result?.status) {
        showSnackBar(
          `Request Id ${actTarget.REQUEST_ID} ${
            actType === "APPROVE" ? "Approved" : "Rejected"
          } successfully`,
          "success",
        );
      }
    } catch (error) {
      showSnackBar(error?.message || "Something went wrong", "error");
      console.error(error);
    } finally {
      setActOpen(false);
      setActTarget(null);
      fetchList("PENDING");
    }
  };

  return (
    <Box sx={{ p: 2 }}>
      {/* Unified Card Container */}
      <Card
        sx={{
          width: "100%",
          boxShadow: 3,
          borderRadius: 2,
          bgcolor: "background.paper",
          overflow: "hidden", // Prevents DataGrid from spilling over
        }}
      >
        <RequestAnalytics data={AnalysisData || []} showDeleteRequest={true} />

        {/* Clean separation between charts and grid */}
        <Divider />

        <ApprovalTable
          rows={rows}
          loading={loading}
          onViewDetails={openDetails}
          onApprove={openApprove}
          onReject={openReject}
        />
      </Card>

      <ApproveRejectDialog
        open={actOpen}
        type={actType}
        target={actTarget}
        loading={loading}
        onClose={() => {
          setActOpen(false);
          setActTarget(null);
        }}
        onConfirm={handleConfirm}
      />

      <UserRequestView
        open={detailsOpen}
        data={detailsRow}
        handleClose={() => {
          setDetailsOpen(false);
          setDetailsRow(null);
        }}
      />
    </Box>
  );
}
